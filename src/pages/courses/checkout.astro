---
import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'astro:content';

const courses = await getCollection('courses');

const courseCatalog = courses.map((c) => ({
  slug: c.id.replace(/\.md$/, ''),
  title: c.data.title,
  duration: c.data.duration,
  totalLessons: c.data.totalLessons,
  level: c.data.level,
  price: Number(c.data.price),
  originalPrice: Number(c.data.originalPrice ?? c.data.price),
  discountBadge: c.data.discountBadge ?? '',
  installmentPrice: Number(c.data.installmentPrice ?? 0),
  installmentPlanText: c.data.installmentPlanText ?? '',
}));
---

<Layout title="Verified Payment Terminal — Shibaji Debnath">
  <div class="min-h-screen bg-slate-50 dark:bg-[#06080f] text-slate-900 dark:text-slate-200 py-12 px-4 sm:px-6 lg:px-8 transition-colors duration-300">
    <div class="max-w-5xl mx-auto">
      
      <!-- Top Navigation / Progress Indicator -->
      <div class="mb-8">
        <a 
          id="back_to_enquiry"
          href="/courses" 
          class="text-xs font-mono uppercase tracking-widest text-sky-700 dark:text-sky-400 hover:text-sky-600 dark:hover:text-sky-300 flex items-center gap-1 transition-colors"
        >
          &larr; Modify Registration / Candidate Profile
        </a>
        <h1 class="text-3xl sm:text-4xl font-black text-slate-950 dark:text-white tracking-tight mt-3">
          Verified Payment <span class="text-transparent bg-clip-text bg-gradient-to-r from-sky-600 to-indigo-600 dark:from-sky-400 dark:to-indigo-400">Terminal</span>
        </h1>
        <p class="text-sm text-slate-700 dark:text-slate-400 mt-2 max-w-2xl">
          Review your enrolled cohort details and locked invoice profile before redirecting to the PayU secure transaction gateway.
        </p>
      </div>

      <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">
        
        <!-- Left Column: Locked Candidate Dossier & Gateway Trigger Form -->
        <div class="lg:col-span-7 space-y-6">
          
          <!-- Candidate Identity Card -->
          <div class="bg-white dark:bg-[#0b101d]/90 border border-slate-200 dark:border-slate-800/80 rounded-2xl p-6 sm:p-8 backdrop-blur shadow-xl dark:shadow-2xl relative overflow-hidden transition-colors duration-300">
            <div class="absolute -right-8 -top-8 w-32 h-32 bg-sky-500/10 dark:bg-sky-500/5 rounded-full blur-2xl pointer-events-none"></div>

            <div class="flex items-center justify-between pb-6 border-b border-slate-200 dark:border-slate-800/60 mb-6 relative z-10">
              <span class="text-xs font-mono tracking-widest uppercase text-emerald-700 dark:text-emerald-400 flex items-center gap-2">
                <span class="h-2 w-2 rounded-full bg-emerald-600 dark:bg-emerald-400"></span>
                Verified Candidate Profile
              </span>
              <span class="text-xs font-mono text-slate-500 uppercase tracking-widest">Step 2 of 2</span>
            </div>

            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 text-xs font-mono relative z-10">
              <div class="p-3.5 rounded-xl bg-slate-50 dark:bg-[#070b14] border border-slate-200 dark:border-slate-800/60">
                <span class="block text-[10px] text-slate-500 dark:text-slate-500 uppercase">Enrolled Candidate</span>
                <span id="display_candidate_name" class="font-bold text-slate-950 dark:text-white text-sm mt-0.5 block truncate">--</span>
              </div>

              <div class="p-3.5 rounded-xl bg-slate-50 dark:bg-[#070b14] border border-slate-200 dark:border-slate-800/60">
                <span class="block text-[10px] text-slate-500 dark:text-slate-500 uppercase">Contact Email</span>
                <span id="display_candidate_email" class="font-bold text-slate-950 dark:text-white text-sm mt-0.5 block truncate">--</span>
              </div>

              <div class="p-3.5 rounded-xl bg-slate-50 dark:bg-[#070b14] border border-slate-200 dark:border-slate-800/60 sm:col-span-2 flex items-center justify-between gap-2">
                <div class="min-w-0">
                  <span class="block text-[10px] text-slate-500 dark:text-slate-500 uppercase">Registered WhatsApp</span>
                  <span id="display_candidate_phone" class="font-bold text-slate-950 dark:text-white text-sm mt-0.5 block truncate">--</span>
                </div>
                <span class="text-[10px] font-mono px-2 py-1 rounded bg-emerald-100 dark:bg-emerald-500/10 text-emerald-800 dark:text-emerald-400 border border-emerald-300 dark:border-emerald-500/20 whitespace-nowrap">
                  LOCKED
                </span>
              </div>
            </div>
          </div>

          <!-- Checkout Action Terminal Form -->
          <form id="checkout_gateway_form" class="bg-white dark:bg-[#0b101d]/90 border border-slate-200 dark:border-slate-800/80 rounded-2xl p-6 sm:p-8 backdrop-blur shadow-xl dark:shadow-2xl space-y-6 transition-colors duration-300">
            <!-- Hidden Fields Dispatched to /api/payu/init.php -->
            <input type="hidden" name="course_id" id="pay_course_slug" value="" />
            <input type="hidden" name="course_title" id="pay_course_title" value="" />
            <input type="hidden" name="payment_plan" id="pay_payment_plan" value="full" />
            <input type="hidden" name="amount" id="pay_amount" value="0" />
            <input type="hidden" name="firstname" id="pay_full_name" value="" />
            <input type="hidden" name="email" id="pay_email" value="" />
            <input type="hidden" name="phone" id="pay_phone" value="" />

            <div class="space-y-3">
              <div class="flex items-center justify-between p-4 rounded-xl bg-sky-50 dark:bg-sky-950/20 border border-sky-200 dark:border-sky-500/30">
                <div class="flex items-center gap-3">
                  <div class="w-9 h-9 rounded-lg bg-sky-100 dark:bg-sky-500/20 text-sky-700 dark:text-sky-400 flex items-center justify-center font-bold text-sm">
                    ⚡
                  </div>
                  <div>
                    <h4 class="text-sm font-bold text-slate-950 dark:text-white">Direct PayU Payment Gateway</h4>
                    <p class="text-[11px] text-slate-600 dark:text-slate-400">Cards, UPI (GPay/PhonePe), NetBanking &amp; EMI</p>
                  </div>
                </div>
                <span class="text-[10px] font-mono text-sky-800 dark:text-sky-400 px-2.5 py-1 rounded bg-sky-100 dark:bg-sky-500/10 border border-sky-300 dark:border-sky-500/20 uppercase font-bold">
                  Active
                </span>
              </div>
            </div>

            <!-- Dynamic Error Feedback Notice -->
            <div id="checkout_error_box" class="hidden p-4 rounded-xl bg-rose-50 dark:bg-rose-950/40 border border-rose-200 dark:border-rose-900/60 text-rose-700 dark:text-rose-300 text-xs font-mono">
              <span id="checkout_error_text">Payment initiation error.</span>
            </div>

            <button 
              type="submit" 
              id="pay_btn"
              class="w-full py-4 px-6 rounded-xl bg-gradient-to-r from-emerald-600 to-teal-700 dark:from-emerald-500 dark:to-teal-600 hover:from-emerald-500 hover:to-teal-600 dark:hover:from-emerald-400 dark:hover:to-teal-500 text-white font-bold text-base tracking-wide shadow-xl shadow-emerald-500/30 dark:shadow-emerald-500/20 hover:shadow-emerald-500/40 dark:hover:shadow-emerald-500/30 transition-all flex items-center justify-center gap-3 cursor-pointer disabled:opacity-60 disabled:cursor-not-allowed"
            >
              <span id="btn_action_label">Initiate Secure Transaction</span>
              <span id="btn_amount_display" class="font-mono bg-black/20 dark:bg-black/30 px-2.5 py-1 rounded text-sm">₹0</span>
              <span id="btn_arrow">&rarr;</span>
            </button>

            <div class="flex items-center justify-center gap-6 text-slate-500 dark:text-slate-500 text-xs font-mono pt-2 flex-wrap">
              <span class="flex items-center gap-1">🔒 256-Bit SSL</span>
              <span class="flex items-center gap-1">🛡️ SHA-512 Signed</span>
              <span class="flex items-center gap-1">⚡ Instant Invoicing</span>
            </div>
          </form>

        </div>

        <!-- Right Column: Line-Item Order Invoice Breakdown -->
        <div class="lg:col-span-5 bg-white dark:bg-[#0b101d]/90 border border-slate-200 dark:border-slate-800/80 rounded-2xl p-6 sm:p-8 backdrop-blur shadow-xl dark:shadow-2xl space-y-6 sticky top-8 transition-colors duration-300">
          
          <div class="pb-5 border-b border-slate-200 dark:border-slate-800/60">
            <span class="text-[11px] font-mono tracking-widest uppercase text-slate-500 dark:text-slate-400">Enrolled Program</span>
            <h2 id="invoice_course_title" class="text-lg sm:text-xl font-black text-slate-950 dark:text-white mt-1 leading-snug">
              Loading Cohort...
            </h2>
            <div class="flex flex-wrap items-center gap-2 mt-3 font-mono text-[11px]">
              <span id="invoice_badge_duration" class="px-2.5 py-1 rounded-md bg-sky-100 dark:bg-sky-950/60 text-sky-800 dark:text-sky-400 border border-sky-200 dark:border-sky-800/40">--</span>
              <span id="invoice_badge_lessons" class="px-2.5 py-1 rounded-md bg-indigo-100 dark:bg-indigo-950/60 text-indigo-800 dark:text-indigo-400 border border-indigo-200 dark:border-indigo-800/40">--</span>
              <span id="invoice_badge_level" class="px-2.5 py-1 rounded-md bg-slate-100 dark:bg-slate-800 text-slate-700 dark:text-slate-300 border border-slate-200 dark:border-slate-700/50">--</span>
            </div>
          </div>

          <!-- Billing Line Items -->
          <div class="space-y-3.5 text-xs text-slate-700 dark:text-slate-300">
            <div class="flex justify-between items-center py-1">
              <span class="text-slate-500 dark:text-slate-400">Tuition Standard Rate</span>
              <span id="invoice_original_rate" class="font-mono line-through text-slate-400 dark:text-slate-500">₹0</span>
            </div>
            <div class="flex justify-between items-center py-1">
              <span class="text-slate-500 dark:text-slate-400">Payment Milestone Structure</span>
              <span id="invoice_plan_type" class="font-mono font-medium text-slate-950 dark:text-white">Full Cohort Access</span>
            </div>
            <div class="flex justify-between items-center py-1">
              <span class="text-slate-500 dark:text-slate-400">Tuition Scholarship / Waiver</span>
              <span id="invoice_scholarship_discount" class="font-mono text-emerald-700 dark:text-emerald-400 font-semibold">-₹0</span>
            </div>
            <div class="flex justify-between items-center py-1">
              <span class="text-slate-500 dark:text-slate-400">Architecture Sandbox &amp; Labs</span>
              <span class="font-mono text-emerald-700 dark:text-emerald-400 font-semibold">Covered</span>
            </div>
            <div class="flex justify-between items-center py-1">
              <span class="text-slate-500 dark:text-slate-400">Processing / Gateway Fee</span>
              <span class="font-mono text-emerald-700 dark:text-emerald-400 font-semibold">₹0.00</span>
            </div>
          </div>

          <!-- Total Invoice Due Section -->
          <div class="pt-5 border-t border-slate-200 dark:border-slate-800/80 flex items-baseline justify-between">
            <div>
              <span class="block text-xs font-mono uppercase tracking-wider text-slate-500 dark:text-slate-400">Total Net Payable</span>
              <span class="text-[10px] text-slate-400 dark:text-slate-500">Guaranteed fixed rate</span>
            </div>
            <div class="text-right">
              <span id="invoice_final_amount" class="text-2xl sm:text-3xl font-black text-sky-700 dark:text-sky-400 font-mono">₹0</span>
              <span class="block text-[10px] font-mono text-slate-400 dark:text-slate-500">INR TOTAL</span>
            </div>
          </div>

          <!-- Confirmation Notice -->
          <div class="pt-4 border-t border-slate-200 dark:border-slate-800/40 space-y-2 text-[11px] text-slate-600 dark:text-slate-400">
            <p>
              Your payment will be securely recorded. Upon completion, enrollment credentials and your signed admission invoice are automatically dispatched to your email.
            </p>
          </div>

        </div>

      </div>
    </div>
  </div>

  <!-- Client-Side Invoice Resolution & Gateway Redirection Script -->
  <script define:vars={{ courseCatalog }}>
    function initCheckoutPage() {
      const params = new URLSearchParams(window.location.search);
      const courseSlug = params.get('course');
      const plan = (params.get('plan') || 'full').toLowerCase();
      const name = params.get('name') || '';
      const email = params.get('email') || '';
      const phone = params.get('phone') || '';

      // ১. ক্যাটালগ থেকে কোর্স নির্বাচন
      const course = courseCatalog.find((c) => c.slug === courseSlug) || courseCatalog[0];
      if (!course) return;

      // ২. অ্যামাউন্ট নির্ধারণ (Full বনাম Installment)
      const isInstallment = plan === 'installment' && course.installmentPrice > 0;
      const payableAmount = isInstallment ? course.installmentPrice : course.price;
      const planLabel = isInstallment ? 'Milestone Split Installment' : 'Full Cohort Access';
      const savings = Math.max(0, course.originalPrice - payableAmount);

      // ৩. ব্যাক লিঙ্ক কোয়েরি রিটেইন করা
      const backLink = document.getElementById('back_to_enquiry');
      if (backLink) {
        backLink.href = `/courses/enquiry?course=${course.slug}&plan=${plan}`;
      }

      // ৪. ক্যান্ডিডেট ডেটা ভিউ আপডেট
      const nameEl = document.getElementById('display_candidate_name');
      const emailEl = document.getElementById('display_candidate_email');
      const phoneEl = document.getElementById('display_candidate_phone');

      if (nameEl) nameEl.textContent = name || 'Candidate';
      if (emailEl) emailEl.textContent = email || 'Unspecified';
      if (phoneEl) phoneEl.textContent = phone || 'Unspecified';

      // ৫. ইনভয়েস মেটা আপডেট
      const invTitleEl = document.getElementById('invoice_course_title');
      const invDurationEl = document.getElementById('invoice_badge_duration');
      const invLessonsEl = document.getElementById('invoice_badge_lessons');
      const invLevelEl = document.getElementById('invoice_badge_level');
      const invOriginalEl = document.getElementById('invoice_original_rate');
      const invPlanEl = document.getElementById('invoice_plan_type');
      const invScholarEl = document.getElementById('invoice_scholarship_discount');
      const invFinalEl = document.getElementById('invoice_final_amount');
      const btnAmountEl = document.getElementById('btn_amount_display');

      if (invTitleEl) invTitleEl.textContent = course.title;
      if (invDurationEl) invDurationEl.textContent = course.duration;
      if (invLessonsEl) invLessonsEl.textContent = `${course.totalLessons} Lessons`;
      if (invLevelEl) invLevelEl.textContent = course.level;
      if (invOriginalEl) invOriginalEl.textContent = `₹${course.originalPrice.toLocaleString('en-IN')}`;
      if (invPlanEl) invPlanEl.textContent = planLabel;
      if (invScholarEl) invScholarEl.textContent = `-₹${savings.toLocaleString('en-IN')}`;
      if (invFinalEl) invFinalEl.textContent = `₹${payableAmount.toLocaleString('en-IN')}`;
      if (btnAmountEl) btnAmountEl.textContent = `₹${payableAmount.toLocaleString('en-IN')}`;

      // ৬. হিডেন ফর্ম ফিল্ডস পপুলেট করা
      const paySlugInput = document.getElementById('pay_course_slug');
      const payTitleInput = document.getElementById('pay_course_title');
      const payPlanInput = document.getElementById('pay_payment_plan');
      const payAmountInput = document.getElementById('pay_amount');
      const payNameInput = document.getElementById('pay_full_name');
      const payEmailInput = document.getElementById('pay_email');
      const payPhoneInput = document.getElementById('pay_phone');

      if (paySlugInput) paySlugInput.value = course.slug;
      if (payTitleInput) payTitleInput.value = course.title;
      if (payPlanInput) payPlanInput.value = plan;
      if (payAmountInput) payAmountInput.value = payableAmount;
      if (payNameInput) payNameInput.value = name;
      if (payEmailInput) payEmailInput.value = email;
      if (payPhoneInput) payPhoneInput.value = phone;

      // ৭. গেটওয়ে ইন্টারসেপ্টর (Fetch API দিয়ে হ্যাশ এনে PayU গেটওয়েতে ব্রাউজার সাবমিট)
      const form = document.getElementById('checkout_gateway_form');
      const payBtn = document.getElementById('pay_btn');
      const btnActionLabel = document.getElementById('btn_action_label');
      const errorBox = document.getElementById('checkout_error_box');
      const errorText = document.getElementById('checkout_error_text');

      if (form && !form.dataset.initialized) {
        form.dataset.initialized = 'true';

        form.addEventListener('submit', async function (e) {
          e.preventDefault();

          if (errorBox) errorBox.classList.add('hidden');
          if (payBtn) payBtn.disabled = true;
          if (btnActionLabel) btnActionLabel.textContent = 'Securing Gateway Session...';

          const formData = new FormData(form);
          const payload = Object.fromEntries(formData.entries());

          try {
            const res = await fetch('/api/payu/init.php', {
              method: 'POST',
              headers: {
                'Content-Type': 'application/json',
                'Accept': 'application/json'
              },
              body: JSON.stringify(payload)
            });

            const data = await res.json();

            if (data.status === 'success') {
              // ফ্রি কোর্স হলে সরাসরি সাকসেস পেজে
              if (data.is_free) {
                window.location.href = data.redirect_url;
                return;
              }

              // পেইড কোর্স হলে ডাইনামিক ফর্ম বানিয়ে PayU-তে ব্রাউজার সাবমিট
              if (btnActionLabel) btnActionLabel.textContent = 'Redirecting to PayU...';

              const payuForm = document.createElement('form');
              payuForm.method = 'POST';
              payuForm.action = data.action;

              for (const [key, val] of Object.entries(data.params)) {
                const input = document.createElement('input');
                input.type = 'hidden';
                input.name = key;
                input.value = String(val);
                payuForm.appendChild(input);
              }

              document.body.appendChild(payuForm);
              payuForm.submit();
            } else {
              if (errorText) errorText.textContent = data.message || 'Payment initiation failed.';
              if (errorBox) errorBox.classList.remove('hidden');
              if (payBtn) payBtn.disabled = false;
              if (btnActionLabel) btnActionLabel.textContent = 'Initiate Secure Transaction';
            }
          } catch (err) {
            if (errorText) errorText.textContent = 'Network communication failure. Please check backend PHP service.';
            if (errorBox) errorBox.classList.remove('hidden');
            if (payBtn) payBtn.disabled = false;
            if (btnActionLabel) btnActionLabel.textContent = 'Initiate Secure Transaction';
          }
        });
      }
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initCheckoutPage);
    } else {
      initCheckoutPage();
    }
    document.addEventListener('astro:page-load', initCheckoutPage);
  </script>
</Layout>