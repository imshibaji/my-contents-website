---
import Layout from '../../layouts/Layout.astro';
---

<Layout title="Transaction Incomplete | Shibaji Debnath" description="Payment could not be completed.">
  <div class="min-h-screen py-20 flex items-center justify-center px-6">
    <div class="max-w-lg w-full p-8 sm:p-10 rounded-3xl border border-rose-500/30 bg-white dark:bg-[#070e1c] shadow-2xl text-center space-y-5">
      
      <div class="w-16 h-16 mx-auto rounded-full bg-rose-500/10 border border-rose-500/30 flex items-center justify-center text-rose-500 text-2xl font-bold">
        ✕
      </div>

      <div class="space-y-1">
        <span class="text-xs font-mono uppercase tracking-wider text-rose-600 dark:text-rose-400 font-bold">Transaction Unsuccessful</span>
        <h1 class="text-2xl sm:text-3xl font-black text-slate-900 dark:text-white">Payment Incomplete</h1>
      </div>

      <p class="text-sm text-slate-600 dark:text-slate-300 leading-relaxed font-normal">
        The transaction was cancelled or declined by your bank. Any debited funds are typically refunded automatically within 24–48 hours.
      </p>

      <div class="pt-4 flex flex-col sm:flex-row gap-3">
        <a href="/courses/checkout" class="flex-1 py-3 rounded-xl bg-sky-600 hover:bg-sky-500 text-xs font-mono font-bold text-white transition-all shadow-md shadow-sky-600/20">
          Try Again
        </a>
        <a href="/contact" class="flex-1 py-3 rounded-xl border border-sky-200 dark:border-sky-900 bg-white dark:bg-slate-900 text-xs font-mono font-bold text-slate-700 dark:text-slate-200 hover:border-sky-500 transition-all">
          Contact Advisory
        </a>
      </div>

    </div>
  </div>
</Layout>