---
import '../styles/global.css';
import Navbar from '../components/Navbar.astro';
import Footer from './Footer.astro';
import CookieConsent from '../components/CookieConsent.astro';

const GA_MEASUREMENT_ID = 'G-25F8G4W39Y'; // 👈 আপনার আইডি দিয়ে পরিবর্তন করুন
const GOOGLE_ADS_ID     = 'AW-16766094351';

interface Props {
  title: string;
  keywords?: string;
  description?: string;
  ogImage?: string;
  articleDate?: string;
  type?: 'website' | 'profile' | 'article';
}

const { 
  title,
  keywords = "Shibaji Debnath, CTO, System Architect, Ex-Google, NestJS, Agentic AI, MCP Plugins, Laravel, Microservices, Fractional CTO", 
  description = "Chief Technology Officer, Lead Technical Consultant & Senior System Architect with 15+ years of experience in NestJS microservices, Agentic AI, MCP plugins, and cloud scale.", 
  ogImage = "/profile.jpg",
  articleDate,
  type = "website"
} = Astro.props;

const siteUrl = "https://shibajidebnath.com";
const canonicalURL = new URL(Astro.url.pathname, siteUrl);

// Google & LLM Entity Schema Graph
const schemaGraph = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Person",
      "@id": `${siteUrl}/#person`,
      "name": "Shibaji Debnath",
      "alternateName": ["Shibaji", "imshibaji"],
      "jobTitle": "Chief Technology Officer & Senior System Architect",
      "url": siteUrl,
      "image": `${siteUrl}/${ogImage || '/profile.jpg'}?w=200&h=200&fit=crop&auto=format&bg=444`,
      "sameAs": [
        "https://github.com/imshibaji",
        "https://linkedin.com/in/shibaji"
      ],
      "alumniOf": {
        "@type": "Organization",
        "name": "Google"
      },
      "worksFor": {
        "@type": "Organization",
        "name": "SDN Technology"
      },
      "knowsAbout": [
        "System Architecture",
        "NestJS",
        "Agentic AI Workflows",
        "Model Context Protocol (MCP)",
        "Microservices Architecture",
        "Laravel",
        "LeafPHP",
        "PostgreSQL",
        "Redis Streams",
        "Docker Containerization",
        "Flutter",
        "Angular",
        "React",
        "Vue",
        "Next.js",
        "Astro",
        "OpenAI APIs",
        "n8n"
      ],
      "hasOccupation": [
        {
          "@type": "Occupation",
          "name": "Chief Technology Officer"
        },
        {
          "@type": "Occupation",
          "name": "Lead Technical Consultant"
        },
        {
          "@type": "Occupation",
          "name": "Senior System Architect"
        },
        {
          "@type": "Occupation",
          "name": "Training & Consulting Coach"
        },
        {
          "@type": "Occupation",
          "name": "Mentor & Trainer"
        }
      ],
      "talksAbout": [
        "NestJS",
        "Agentic AI Workflows",
        "Model Context Protocol (MCP)",
        "Microservices Architecture",
        "Laravel",
        "LeafPHP",
        "PostgreSQL",
        "Redis Streams",
        "Docker Containerization",
        "Flutter",
        "Angular",
        "React",
        "Vue",
        "Next.js",
        "Astro",
        "OpenAI APIs",
        "n8n"
      ],
      "title": title,
      "keywords": keywords,
      "description": description
    },
    {
      "@type": "ProfessionalService",
      "@id": `${siteUrl}/#service`,
      "name": "Shibaji Debnath Technical Advisory & Architecture",
      "url": siteUrl,
      "provider": { "@id": `${siteUrl}/#person` },
      "serviceType": [
        "System Architecture Consulting",
        "Fractional CTO Advisory",
        "Agentic AI & MCP Integration",
        "High-Concurrency Performance Audits"
      ],
      "areaServed": ["Worldwide", "India", "Europe", "Australia", "United States"],
      "hasOfferCatalog": {
        "@type": "OfferCatalog",
        "name": "Technical Leadership Offerings",
        "itemListElement": [
          {
            "@type": "Offer",
            "itemOffered": {
              "@type": "Service",
              "name": "Fractional CTO & Technical Roadmapping"
            }
          },
          {
            "@type": "Offer",
            "itemOffered": {
              "@type": "Service",
              "name": "Distributed Microservice Architecture (NestJS/Go)"
            }
          },
          {
            "@type": "Offer",
            "itemOffered": {
              "@type": "Service",
              "name": "Agentic AI & Custom MCP Tool Development"
            }
          }
        ]
      }
    }
  ]
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    
    <!-- Primary Metadata -->
    <title>{title}</title>
    <meta name="title" content={title} />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    
    <!-- Crawler Controls for SEO & GEO -->
    <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />
    <meta name="author" content="Shibaji Debnath" />
    <meta name="publisher" content="Shibaji Debnath" />
    <meta name="keywords" content={keywords} />

    <!-- Open Graph (Facebook, LinkedIn, Discord) -->
    <meta property="og:type" content={type} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={new URL(ogImage, siteUrl)} />
    <meta property="og:site_name" content="Shibaji Debnath | System Architect" />
    {articleDate && <meta property="article:published_time" content={articleDate} />}

    <!-- Twitter / X Cards -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:url" content={canonicalURL} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={new URL(ogImage, siteUrl)} />

    <!-- AI Model Quick Context Hook -->
    <link rel="help" href="/llms.txt" title="LLM Context Reference" />

    <!-- Google & LLM Entity Schema Graph -->
    <script type="application/ld+json" set:html={JSON.stringify(schemaGraph)} />

    <!-- Prevent Theme Flash -->
    <script is:inline>
      const theme = (() => {
        if (typeof localStorage !== 'undefined' && localStorage.getItem('theme')) {
          return localStorage.getItem('theme');
        }
        return window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
      })();
      if (theme === 'light') {
        document.documentElement.classList.remove('dark');
      } else {
        document.documentElement.classList.add('dark');
      }
      window.localStorage.setItem('theme', theme);
    </script>

    <!-- ১. Google Consent Mode v2 (সবসময় শীর্ষে থাকবে) -->
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){ dataLayer.push(arguments); }

      gtag('consent', 'default', {
        'ad_storage': 'denied',
        'analytics_storage': 'denied',
        'ad_user_data': 'denied',
        'ad_personalization': 'denied',
        'wait_for_update': 500
      });

      try {
        const savedConsent = localStorage.getItem('user_cookie_consent_v2');
        if (savedConsent) {
          const state = JSON.parse(savedConsent);
          gtag('consent', 'update', {
            'analytics_storage': state.analytics ? 'granted' : 'denied',
            'ad_storage': state.marketing ? 'granted' : 'denied',
            'ad_user_data': state.marketing ? 'granted' : 'denied',
            'ad_personalization': state.marketing ? 'granted' : 'denied'
          });
        }
      } catch (e) {}
    </script>

    <!-- ২. Google Tags Loader (gtag.js) -->
    <script 
      is:inline 
      async 
      src={`https://www.googletagmanager.com/gtag/js?id=${GA_MEASUREMENT_ID}`}
    ></script>

    <script is:inline define:vars={{ GA_MEASUREMENT_ID, GOOGLE_ADS_ID }}>
      window.dataLayer = window.dataLayer || [];
      function gtag(){ dataLayer.push(arguments); }
      gtag('js', new Date());

      // Google Analytics ইনিশিয়ালাইজ
      gtag('config', GA_MEASUREMENT_ID, { send_page_view: false });

      // Google Ads ইনিশিয়ালাইজ
      if (GOOGLE_ADS_ID) {
        gtag('config', GOOGLE_ADS_ID);
      }
    </script>

    <!-- ৩. Astro Page View ট্র্যাকিং -->
    <script is:inline define:vars={{ GA_MEASUREMENT_ID }}>
      function trackPageView() {
        if (typeof gtag === 'function') {
          gtag('event', 'page_view', {
            page_title: document.title,
            page_location: window.location.href,
            page_path: window.location.pathname
          });
        }
      }

      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', trackPageView);
      } else {
        trackPageView();
      }
      document.addEventListener('astro:page-load', trackPageView);
    </script>
  </head>
  <body class="bg-sky-50/30 text-slate-800 dark:bg-[#030712] dark:text-slate-100 font-sans transition-colors duration-300 antialiased selection:bg-sky-500 selection:text-white flex flex-col min-h-screen">
    <Navbar />
    <main class="flex-grow">
      <slot />
    </main>
    <Footer />
    <CookieConsent />
  </body>
</html>