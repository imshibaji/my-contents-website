---
import Layout from '../layouts/Layout.astro';
---

<Layout 
  title="Contact & Executive Consultation | Shibaji Debnath"
  description="Initiate an architectural audit, fractional CTO advisory engagement, or full-time technical leadership discussion with Shibaji Debnath."
>

  <header class="py-16 md:py-20 border-b border-sky-100 dark:border-sky-950/50 bg-white/40 dark:bg-[#040813]">
    <div class="max-w-6xl mx-auto px-6">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full border border-sky-200 dark:border-sky-900/80 bg-sky-50 dark:bg-sky-950/40 text-xs font-mono font-semibold text-sky-700 dark:text-sky-300 mb-4">
        <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span>
        Direct Channel Open
      </div>
      <h1 class="text-4xl sm:text-5xl font-extrabold text-slate-900 dark:text-white tracking-tight">
        Initiate Technical Consultation
      </h1>
      <p class="text-base sm:text-lg text-slate-600 dark:text-slate-300 max-w-2xl mt-3 leading-relaxed">
        Whether you require an architectural audit, fractional CTO leadership, or a high-throughput backend implementation, let's connect.
      </p>
    </div>
  </header>

  <main class="py-16 max-w-6xl mx-auto px-6">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-start">
      
      <!-- Left Column: Executive Meta & Channels -->
      <div class="lg:col-span-5 space-y-8">
        
        <div class="p-8 rounded-3xl border border-sky-100 dark:border-sky-950/80 bg-white dark:bg-[#070d1a] shadow-xs">
          <h2 class="text-xs font-mono font-bold uppercase tracking-wider text-sky-600 dark:text-sky-400 mb-4">
            Direct Routing
          </h2>
          
          <div class="space-y-6 text-sm">
            <div class="flex items-start gap-4">
              <div class="w-10 h-10 rounded-xl bg-sky-50 dark:bg-sky-950/60 border border-sky-200/60 dark:border-sky-900/60 flex items-center justify-center text-sky-600 dark:text-sky-400 shrink-0">
                <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/></svg>
              </div>
              <div>
                <p class="text-xs font-mono text-slate-400 uppercase">Primary Inquiries</p>
                <a href="mailto:imshibaji@gmail.com" class="font-bold text-slate-800 dark:text-slate-200 hover:text-sky-600 dark:hover:text-sky-400 transition-colors">
                  imshibaji@gmail.com
                </a>
              </div>
            </div>

            <div class="flex items-start gap-4">
              <div class="w-10 h-10 rounded-xl bg-sky-50 dark:bg-sky-950/60 border border-sky-200/60 dark:border-sky-900/60 flex items-center justify-center text-sky-600 dark:text-sky-400 shrink-0">
                <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/></svg>
              </div>
              <div>
                <p class="text-xs font-mono text-slate-400 uppercase">Phone / WhatsApp</p>
                <a href="tel:+918981009499" class="font-bold text-slate-800 dark:text-slate-200 hover:text-sky-600 dark:hover:text-sky-400 transition-colors">
                  +91 8981009499
                </a>
              </div>
            </div>

            <div class="flex items-start gap-4">
              <div class="w-10 h-10 rounded-xl bg-sky-50 dark:bg-sky-950/60 border border-sky-200/60 dark:border-sky-900/60 flex items-center justify-center text-sky-600 dark:text-sky-400 shrink-0">
                <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/></svg>
              </div>
              <div>
                <p class="text-xs font-mono text-slate-400 uppercase">Operating Base</p>
                <p class="font-bold text-slate-800 dark:text-slate-200">
                  Kolkata, West Bengal, India
                </p>
                <p class="text-xs text-slate-500 mt-0.5">Available for remote & hybrid engagements worldwide.</p>
              </div>
            </div>
          </div>

          <div class="pt-6 mt-6 border-t border-sky-100 dark:border-sky-950/60 flex items-center gap-3">
            <a href="https://linkedin.com/in/shibaji" target="_blank" rel="noopener noreferrer" class="flex-1 py-2.5 rounded-xl border border-sky-200 dark:border-sky-900 bg-sky-50/50 dark:bg-slate-900 text-center text-xs font-mono font-bold text-slate-700 dark:text-slate-200 hover:border-sky-500 transition-all">
              LinkedIn
            </a>
            <a href="https://github.com/imshibaji" target="_blank" rel="noopener noreferrer" class="flex-1 py-2.5 rounded-xl border border-sky-200 dark:border-sky-900 bg-sky-50/50 dark:bg-slate-900 text-center text-xs font-mono font-bold text-slate-700 dark:text-slate-200 hover:border-sky-500 transition-all">
              GitHub
            </a>
          </div>
        </div>

        <!-- Scope Checklist Card -->
        <div class="p-6 rounded-3xl border border-sky-100 dark:border-sky-950/80 bg-sky-50/40 dark:bg-[#070d1a]/50 text-xs text-slate-600 dark:text-slate-300 space-y-3">
          <p class="font-mono font-bold uppercase tracking-wider text-sky-600 dark:text-sky-400">Available Advisory Scopes</p>
          <ul class="space-y-2">
            <li class="flex items-center gap-2">
              <span class="w-1.5 h-1.5 rounded-full bg-sky-500"></span>
              Fractional CTO & Technical Architecture Roadmapping
            </li>
            <li class="flex items-center gap-2">
              <span class="w-1.5 h-1.5 rounded-full bg-sky-500"></span>
              High-concurrency NestJS / PHP Microservice Audits
            </li>
            <li class="flex items-center gap-2">
              <span class="w-1.5 h-1.5 rounded-full bg-sky-500"></span>
              Custom Model Context Protocol (MCP) & AI Tool Integration
            </li>
          </ul>
        </div>

      </div>

      <!-- Right Column: Interactive Consultation Form -->
      <div class="lg:col-span-7">
        <div class="p-8 md:p-10 rounded-3xl border border-sky-100 dark:border-sky-950/80 bg-white dark:bg-[#070d1a] shadow-xl">
          
          <form id="contact-form" class="space-y-6">
            <!-- Web3Forms Access Key -->
            <input type="hidden" name="access_key" value="YOUR_ACCESS_KEY_HERE" />
            <input type="hidden" name="subject" value="New Technical Advisory Inquiry - shibajidebnath.com" />
            <input type="hidden" name="from_name" value="Consultation Portal" />
            
            <!-- Anti-Spam Honeypot -->
            <input type="checkbox" name="botcheck" class="hidden" style="display: none;" />

            <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
              <div>
                <label for="name" class="block text-xs font-mono font-bold uppercase tracking-wider text-slate-700 dark:text-slate-300 mb-2">
                  Your Name / Title *
                </label>
                <input 
                  type="text" 
                  id="name" 
                  name="name" 
                  required 
                  placeholder="e.g. Alex Morgan (VP Eng)" 
                  class="w-full px-4 py-3.5 rounded-xl border border-sky-200 dark:border-sky-900 bg-sky-50/20 dark:bg-slate-900/60 text-slate-900 dark:text-white placeholder:text-slate-400 focus:outline-none focus:border-sky-500 focus:ring-1 focus:ring-sky-500 transition-colors text-sm"
                />
              </div>

              <div>
                <label for="email" class="block text-xs font-mono font-bold uppercase tracking-wider text-slate-700 dark:text-slate-300 mb-2">
                  Work Email Address *
                </label>
                <input 
                  type="email" 
                  id="email" 
                  name="email" 
                  required 
                  placeholder="alex@company.com" 
                  class="w-full px-4 py-3.5 rounded-xl border border-sky-200 dark:border-sky-900 bg-sky-50/20 dark:bg-slate-900/60 text-slate-900 dark:text-white placeholder:text-slate-400 focus:outline-none focus:border-sky-500 focus:ring-1 focus:ring-sky-500 transition-colors text-sm"
                />
              </div>
            </div>

            <div>
              <label for="scope" class="block text-xs font-mono font-bold uppercase tracking-wider text-slate-700 dark:text-slate-300 mb-2">
                Primary Engagement Objective
              </label>
              <select 
                id="scope" 
                name="engagement_scope" 
                class="w-full px-4 py-3.5 rounded-xl border border-sky-200 dark:border-sky-900 bg-sky-50/20 dark:bg-slate-900/60 text-slate-900 dark:text-white focus:outline-none focus:border-sky-500 focus:ring-1 focus:ring-sky-500 transition-colors text-sm"
              >
                <option value="CTO Advisory & Roadmapping">Fractional CTO & Architecture Advisory</option>
                <option value="Microservices & Backend Scale">High-Concurrency Backend Migration (NestJS / Laravel)</option>
                <option value="Agentic AI & MCP Systems">Agentic AI Workflows & Custom MCP Servers</option>
                <option value="Mobile App Architecture">Cross-Platform Mobile Project (Flutter / React Native)</option>
                <option value="Full-Time Staff / Lead Role">Full-Time Principal / Lead Leadership Role</option>
              </select>
            </div>

            <div>
              <label for="message" class="block text-xs font-mono font-bold uppercase tracking-wider text-slate-700 dark:text-slate-300 mb-2">
                System Context or Bottleneck Summary *
              </label>
              <textarea 
                id="message" 
                name="message" 
                rows="5" 
                required 
                placeholder="Describe current architectural constraints, target load metrics, or project scope..." 
                class="w-full px-4 py-3.5 rounded-xl border border-sky-200 dark:border-sky-900 bg-sky-50/20 dark:bg-slate-900/60 text-slate-900 dark:text-white placeholder:text-slate-400 focus:outline-none focus:border-sky-500 focus:ring-1 focus:ring-sky-500 transition-colors text-sm"
              ></textarea>
            </div>

            <!-- Submit Button -->
            <button 
              type="submit" 
              id="submit-btn" 
              class="w-full py-4 rounded-xl font-mono font-bold text-sm text-white bg-sky-600 hover:bg-sky-500 shadow-lg shadow-sky-600/20 transition-all cursor-pointer flex items-center justify-center gap-2"
            >
              <span id="btn-text">Transmit Advisory Inquiry</span>
              <svg id="spinner" class="hidden animate-spin h-5 w-5 text-white" fill="none" viewBox="0 0 24 24">
                <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
              </svg>
            </button>

            <!-- Feedback Response Boxes -->
            <div id="result-success" class="hidden p-4 rounded-xl bg-emerald-50 dark:bg-emerald-950/50 border border-emerald-200 dark:border-emerald-900 text-emerald-800 dark:text-emerald-300 text-xs font-mono text-center">
              ✓ Transmission acknowledged. Shibaji will respond directly to your work email within 24 hours.
            </div>

            <div id="result-error" class="hidden p-4 rounded-xl bg-rose-50 dark:bg-rose-950/50 border border-rose-200 dark:border-rose-900 text-rose-800 dark:text-rose-300 text-xs font-mono text-center">
              ✕ Transmission error. Please email directly to <a href="mailto:imshibaji@gmail.com" class="underline font-bold">imshibaji@gmail.com</a>.
            </div>

          </form>

        </div>
      </div>

    </div>
  </main>

  <!-- Client-Side Form Handler Script -->
  <script is:inline>
    async function initSecureContact() {
      const form = document.getElementById('contact-form');
      const submitBtn = document.getElementById('submit-btn');
      const btnText = document.getElementById('btn-text');
      const spinner = document.getElementById('spinner');
      const successBox = document.getElementById('result-success');
      const errorBox = document.getElementById('result-error');
      const errorMsg = document.getElementById('error-message');
      const csrfInput = document.getElementById('csrf_token');
      const timeInput = document.getElementById('form_timestamp');

      if (!form || !submitBtn) return;

      // Set Time-Trap timestamp on user interaction
      timeInput.value = Math.floor(Date.now() / 1000).toString();

      // Fetch dynamic CSRF token from PHP endpoint
      try {
        const tokenRes = await fetch('/api/csrf.php');
        if (tokenRes.ok) {
          const data = await tokenRes.json();
          if (data.csrf_token) {
            csrfInput.value = data.csrf_token;
          }
        }
      } catch (err) {
        console.warn('Could not pre-fetch CSRF token. Proceeding with fallback.');
      }

      form.addEventListener('submit', async function (e) {
        e.preventDefault();

        submitBtn.disabled = true;
        btnText.textContent = 'Verifying Security & Transmitting...';
        spinner.classList.remove('hidden');
        successBox.classList.add('hidden');
        errorBox.classList.add('hidden');

        const formData = new FormData(form);
        const payload = Object.fromEntries(formData.entries());

        try {
          const res = await fetch('/api/send-mail.php', {
            method: 'POST',
            headers: {
              'Content-Type': 'application/json',
              'Accept': 'application/json'
            },
            body: JSON.stringify(payload)
          });

          const json = await res.json();

          if (res.ok && json.success) {
            successBox.classList.remove('hidden');
            form.reset();
            if (json.new_token) {
              csrfInput.value = json.new_token;
            }
          } else {
            errorMsg.textContent = json.error || 'Security verification failed. Please try again.';
            errorBox.classList.remove('hidden');
          }
        } catch (err) {
          errorMsg.textContent = 'Network communication failure. Please email directly to imshibaji@gmail.com.';
          errorBox.classList.remove('hidden');
        } finally {
          submitBtn.disabled = false;
          btnText.textContent = 'Transmit Encrypted Advisory Inquiry';
          spinner.classList.add('hidden');
        }
      });
    }

    initSecureContact();
    document.addEventListener('astro:after-swap', initSecureContact);
  </script>

</Layout>