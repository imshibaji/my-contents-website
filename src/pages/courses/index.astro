---
import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'astro:content';

const courses = await getCollection('courses');

const allCategories = ["All", ...new Set(courses.map(c => c.data.category))];
const allLevels = ["All", "Beginner", "Intermediate", "Advanced"];

function getCourseThumbnail(c: any) {
  if (c.data.featuredImage) return c.data.featuredImage;
  if (c.data.videoTrailerUrl) {
    const match = c.data.videoTrailerUrl.match(/(?:embed\/|v=|vi\/|youtu\.be\/|\/v\/)([^#&?]*).*/);
    const videoId = (match && match[1]) ? match[1] : null;
    if (videoId) return `https://img.youtube.com/vi/${videoId}/maxresdefault.jpg`;
  }
  return "/profile.png";
}

const coursesSchema = {
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  "name": "Production Engineering Bootcamps & Courses | Shibaji Debnath",
  "description": "High-throughput backend architecture, AI agents, and systems engineering courses by Shibaji Debnath.",
  "hasPart": courses.map(c => ({
    "@type": "Course",
    "name": c.data.title,
    "description": c.data.description,
    "provider": {
      "@type": "Person",
      "name": "Shibaji Debnath",
      "url": "https://shibajidebnath.com"
    }
  }))
};
---

<Layout 
  title="Engineering Mentorship & Systems Courses | Shibaji Debnath"
  description="Master high-concurrency microservices, applied AI agents, and production architecture through live mentorship."
>
  <script type="application/ld+json" set:html={JSON.stringify(coursesSchema)} slot="head" />

  <!-- Compact & Centered Hero Section -->
  <header class="relative overflow-hidden py-10 md:py-14 border-b border-sky-100 dark:border-sky-950/50 bg-white/40 dark:bg-[#040813]">
    <div class="absolute top-0 left-1/2 -translate-x-1/2 w-[750px] h-[250px] bg-gradient-to-tr from-sky-400/15 via-cyan-400/10 to-transparent dark:from-sky-600/20 dark:via-sky-400/10 blur-[100px] rounded-full pointer-events-none -z-10"></div>

    <div class="max-w-5xl mx-auto px-6 text-center">
      <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full border border-sky-200 dark:border-sky-900/80 bg-sky-50 dark:bg-sky-950/40 text-xs font-mono font-semibold text-sky-700 dark:text-sky-300 mb-4 shadow-xs">
        <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span>
        Cohort Enrollment Open
      </div>

      <h1 class="text-3xl sm:text-4xl lg:text-5xl font-black text-slate-900 dark:text-white tracking-tight leading-[1.18] max-w-4xl mx-auto">
        Production Engineering & <span class="text-transparent bg-clip-text bg-gradient-to-r from-sky-600 via-cyan-500 to-sky-400">Architecture Academies</span>
      </h1>

      <p class="text-sm sm:text-base text-slate-600 dark:text-slate-300 max-w-3xl mx-auto mt-3.5 leading-relaxed font-normal">
        Step beyond basic tutorials. Master high-concurrency distributed systems, NestJS microservices, and autonomous AI agents through battle-tested blueprints.
      </p>

      <div class="grid grid-cols-2 sm:grid-cols-4 gap-6 max-w-3xl mx-auto mt-8 pt-6 border-t border-sky-100 dark:border-sky-950/80 text-center">
        <div>
          <span class="block text-2xl sm:text-3xl font-extrabold font-mono text-sky-600 dark:text-sky-400 leading-tight">1-on-1</span>
          <span class="text-[11px] font-mono text-slate-500 dark:text-slate-400 mt-1 block">Architecture Reviews</span>
        </div>
        <div>
          <span class="block text-2xl sm:text-3xl font-extrabold font-mono text-emerald-600 dark:text-emerald-400 leading-tight">100%</span>
          <span class="text-[11px] font-mono text-slate-500 dark:text-slate-400 mt-1 block">Production Stacks</span>
        </div>
        <div>
          <span class="block text-2xl sm:text-3xl font-extrabold font-mono text-cyan-600 dark:text-cyan-400 leading-tight">Ex-Google</span>
          <span class="text-[11px] font-mono text-slate-500 dark:text-slate-400 mt-1 block">Architect Mentorship</span>
        </div>
        <div>
          <span class="block text-2xl sm:text-3xl font-extrabold font-mono text-amber-500 dark:text-amber-400 leading-tight">Live</span>
          <span class="text-[11px] font-mono text-slate-500 dark:text-slate-400 mt-1 block">Interactive Cohorts</span>
        </div>
      </div>
    </div>
  </header>

  <!-- 2-Column Catalog: Filters + Grid -->
  <div class="max-w-6xl mx-auto px-6 py-12 lg:py-16">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 items-start">
      
      <!-- LEFT COLUMN: Filters -->
      <aside class="lg:col-span-4 sticky top-28 self-start">
        <div class="p-6 rounded-3xl border border-sky-100 dark:border-sky-950/80 bg-white dark:bg-[#070d1a] shadow-xs space-y-6">
          
          <div class="flex items-center justify-between pb-4 border-b border-sky-100 dark:border-sky-950">
            <h2 class="text-xs font-mono font-bold uppercase tracking-wider text-slate-900 dark:text-white flex items-center gap-2">
              <svg class="w-4 h-4 text-sky-500" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 4a1 1 0 011-1h16a1 1 0 011 1v2.586a1 1 0 01-.293.707l-6.414 6.414a1 1 0 00-.293.707V17l-4 4v-6.586a1 1 0 00-.293-.707L3.293 7.293A1 1 0 013 6.586V4z" />
              </svg>
              Filter Programs
            </h2>
            <button 
              id="reset-filters-btn" 
              type="button" 
              class="text-[11px] font-mono text-sky-600 dark:text-sky-400 hover:underline cursor-pointer"
            >
              Reset All
            </button>
          </div>

          <!-- Search Box -->
          <div class="space-y-2">
            <label for="course-search" class="block text-[11px] font-mono font-bold uppercase tracking-wider text-slate-400">
              Search Keywords
            </label>
            <div class="relative">
              <div class="absolute inset-y-0 left-0 pl-3.5 flex items-center pointer-events-none text-sky-500">
                <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
                </svg>
              </div>
              <input 
                type="text" 
                id="course-search" 
                placeholder="NestJS, Docker, Redis..." 
                class="w-full pl-9 pr-3 py-2.5 rounded-xl border border-sky-200 dark:border-sky-900 bg-sky-50/20 dark:bg-slate-900/60 text-slate-900 dark:text-white placeholder:text-slate-400 focus:outline-none focus:border-sky-500 text-xs font-medium"
              />
            </div>
          </div>

          <!-- Topic Filters -->
          <div class="space-y-2.5">
            <span class="block text-[11px] font-mono font-bold uppercase tracking-wider text-slate-400">
              Topic:
            </span>
            <div class="flex flex-wrap gap-2">
              {allCategories.map((cat, idx) => (
                <button 
                  type="button" 
                  data-category-btn={cat} 
                  class={`category-filter-btn px-3 py-1.5 rounded-xl text-xs font-mono font-bold transition-all cursor-pointer border ${idx === 0 ? 'bg-sky-600 text-white border-sky-600 shadow-sm' : 'bg-sky-50/60 dark:bg-slate-900 text-slate-700 dark:text-slate-300 border-sky-100 dark:border-sky-950 hover:border-sky-400'}`}
                >
                  {cat}
                </button>
              ))}
            </div>
          </div>

          <!-- Level Filters -->
          <div class="space-y-2.5 pt-4 border-t border-sky-100 dark:border-sky-950">
            <span class="block text-[11px] font-mono font-bold uppercase tracking-wider text-slate-400">
              Experience Level:
            </span>
            <div class="flex flex-wrap gap-1.5">
              {allLevels.map((lvl, idx) => (
                <button 
                  type="button" 
                  data-level-btn={lvl}
                  class={`level-filter-btn text-xs font-mono px-3 py-1.5 rounded-lg border transition-all cursor-pointer ${idx === 0 ? 'border-sky-500 bg-sky-500 text-white' : 'border-sky-100 dark:border-sky-950 bg-sky-50/40 dark:bg-slate-900 text-slate-600 dark:text-slate-400 hover:border-sky-400'}`}
                >
                  {lvl}
                </button>
              ))}
            </div>
          </div>

        </div>
      </aside>

      <!-- RIGHT COLUMN: Course Cards -->
      <main class="lg:col-span-8 min-w-0">
        <div id="courses-grid" class="grid grid-cols-1 md:grid-cols-2 gap-6">
          {courses.map((course) => {
            const thumb = getCourseThumbnail(course);
            const hasVideo = !!course.data.videoTrailerUrl;
            const currency = course.data.currency || "₹";
            const price = Number(course.data.price ?? 0);
            const originalPrice = Number(course.data.originalPrice ?? 0);

            return (
              <article 
                class="course-card group relative rounded-3xl p-5 bg-white dark:bg-[#070e1c] border border-sky-100 dark:border-sky-900/60 hover:border-sky-400/80 dark:hover:border-sky-500/70 shadow-sm hover:shadow-xl hover:shadow-sky-500/10 hover:-translate-y-1 transition-all duration-300 flex flex-col justify-between"
                data-title={course.data.title.toLowerCase()}
                data-desc={course.data.description.toLowerCase()}
                data-category={course.data.category}
                data-level={course.data.level}
                data-tags={(course.data.tags || []).join(",").toLowerCase()}
              >
                <div>
                  <!-- 16:9 Thumbnail Frame -->
                  <a href={`/courses/${course.id}`} class="block relative w-full aspect-video rounded-2xl overflow-hidden mb-4 bg-slate-950 border border-sky-100 dark:border-sky-950 group-hover:opacity-95 transition-opacity">
                    <img 
                      src={thumb} 
                      alt={course.data.title}
                      class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
                      loading="lazy"
                    />

                    <!-- Badges on Thumbnail -->
                    <div class="absolute top-2.5 left-2.5 flex items-center gap-1.5 z-10">
                      <span class="text-[10px] font-mono font-bold uppercase tracking-wider px-2 py-0.5 rounded bg-slate-950/80 text-sky-300 backdrop-blur-md border border-sky-500/30">
                        {course.data.level}
                      </span>
                      <span class="text-[10px] font-mono font-bold uppercase tracking-wider px-2 py-0.5 rounded bg-emerald-950/80 text-emerald-300 backdrop-blur-md border border-emerald-500/30">
                        {course.data.status}
                      </span>
                    </div>

                    {hasVideo && (
                      <div class="absolute inset-0 bg-black/20 flex items-center justify-center">
                        <div class="w-9 h-9 rounded-full bg-white/90 dark:bg-slate-900/90 text-sky-600 flex items-center justify-center shadow-lg transform group-hover:scale-110 transition-transform">
                          <svg class="w-4 h-4 fill-current ml-0.5" viewBox="0 0 24 24"><path d="M8 5v14l11-7z"/></svg>
                        </div>
                      </div>
                    )}
                  </a>

                  <!-- Clean Meta Pill Badges (Wrapped gracefully) -->
                  <div class="flex flex-wrap items-center gap-1.5 text-[11px] font-mono mb-3">
                    <span class="px-2 py-0.5 rounded-md bg-sky-50 dark:bg-sky-950/60 text-sky-700 dark:text-sky-300 border border-sky-200/60 dark:border-sky-900/60 font-medium">
                      ⏱️ {course.data.duration}
                    </span>
                    <span class="px-2 py-0.5 rounded-md bg-slate-100 dark:bg-slate-900 text-slate-600 dark:text-slate-400 border border-slate-200 dark:border-slate-800">
                      {course.data.totalLessons} Lessons
                    </span>
                    <span class="px-2 py-0.5 rounded-md bg-slate-100 dark:bg-slate-900 text-slate-600 dark:text-slate-400 border border-slate-200 dark:border-slate-800">
                      {course.data.mode}
                    </span>
                  </div>

                  <!-- Title -->
                  <h2 class="text-base sm:text-lg font-bold text-slate-900 dark:text-white group-hover:text-sky-600 dark:group-hover:text-sky-400 transition-colors line-clamp-2 leading-snug tracking-tight">
                    <a href={`/courses/${course.id}`}>
                      {course.data.title}
                    </a>
                  </h2>

                  <!-- Description -->
                  <p class="text-xs sm:text-sm text-slate-600 dark:text-slate-300 mt-2 leading-relaxed line-clamp-2 font-normal">
                    {course.data.description}
                  </p>
                </div>

                <!-- Bottom Pricing & Action Strip (Balanced & Single-line Button) -->
                <div class="pt-4 mt-5 border-t border-sky-100 dark:border-sky-950 flex items-end justify-between gap-3">
                  <div class="min-w-0">
                    {price === 0 ? (
                      <div class="flex items-baseline gap-1.5">
                        <span class="text-lg font-black font-mono text-emerald-600 dark:text-emerald-400">
                          Free
                        </span>
                        {originalPrice > 0 && (
                          <span class="text-xs font-mono line-through text-slate-400">
                            {currency}{originalPrice.toLocaleString('en-IN')}
                          </span>
                        )}
                      </div>
                    ) : (
                      <div>
                        <div class="flex flex-wrap items-baseline gap-1.5">
                          <span class="text-lg font-black font-mono text-slate-900 dark:text-white tracking-tight">
                            {currency}{price.toLocaleString('en-IN')}
                          </span>
                          {originalPrice > price && (
                            <span class="text-xs font-mono line-through text-slate-400">
                              {currency}{originalPrice.toLocaleString('en-IN')}
                            </span>
                          )}
                          {course.data.discountBadge && (
                            <span class="text-[10px] font-mono font-bold px-1.5 py-0.5 rounded bg-rose-500/15 text-rose-500 border border-rose-500/30 whitespace-nowrap">
                              {course.data.discountBadge}
                            </span>
                          )}
                        </div>
                        {course.data.offerText && (
                          <span class="block text-[10px] font-mono text-emerald-600 dark:text-emerald-400 font-medium leading-tight mt-1 truncate">
                            {course.data.offerText}
                          </span>
                        )}
                      </div>
                    )}
                  </div>

                  <a 
                    href={`/courses/${course.id}`} 
                    class="shrink-0 inline-flex items-center justify-center px-4 py-2 rounded-xl text-xs font-mono font-bold text-white bg-sky-600 hover:bg-sky-500 shadow-md shadow-sky-600/20 transition-all whitespace-nowrap"
                  >
                    {price === 0 ? 'Start Free →' : 'Enroll →'}
                  </a>
                </div>

              </article>
            );
          })}
        </div>

        <!-- Empty State -->
        <div id="no-courses-msg" class="hidden py-16 text-center">
          <div class="w-12 h-12 mx-auto rounded-2xl bg-sky-50 dark:bg-sky-950/60 border border-sky-200 dark:border-sky-900 text-sky-600 dark:text-sky-400 flex items-center justify-center mb-3">
            <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 14l9-5-9-5-9 5 9 5z"/></svg>
          </div>
          <h3 class="text-base font-bold text-slate-900 dark:text-white">No courses match your filter</h3>
          <p class="text-xs font-mono text-slate-500 mt-1">Try clearing search terms or changing your level selection.</p>
        </div>

        <!-- Pagination Controls -->
        <div id="pagination-controls" class="mt-12 pt-6 border-t border-sky-100 dark:border-sky-950 flex flex-col sm:flex-row items-center justify-between gap-4">
          <div class="text-xs font-mono text-slate-500 dark:text-slate-400">
            Showing <span id="page-item-start" class="font-bold text-slate-800 dark:text-slate-200">1</span>-<span id="page-item-end" class="font-bold text-slate-800 dark:text-slate-200">4</span> of <span id="total-filtered-count" class="font-bold text-slate-800 dark:text-slate-200">{courses.length}</span> programs
          </div>

          <div class="flex items-center gap-2">
            <button 
              id="prev-page-btn" 
              type="button" 
              class="px-3.5 py-1.5 rounded-xl border border-sky-200 dark:border-sky-900 bg-white dark:bg-slate-900 text-xs font-mono font-bold text-slate-700 dark:text-slate-300 hover:border-sky-500 disabled:opacity-40 disabled:pointer-events-none transition-all cursor-pointer"
            >
              &larr; Prev
            </button>
            <div id="page-number-buttons" class="flex items-center gap-1"></div>
            <button 
              id="next-page-btn" 
              type="button" 
              class="px-3.5 py-1.5 rounded-xl border border-sky-200 dark:border-sky-900 bg-white dark:bg-slate-900 text-xs font-mono font-bold text-slate-700 dark:text-slate-300 hover:border-sky-500 disabled:opacity-40 disabled:pointer-events-none transition-all cursor-pointer"
            >
              Next &rarr;
            </button>
          </div>
        </div>

      </main>

    </div>
  </div>
</Layout>

<!-- Client-Side Search, Filter & Pagination Engine -->
<script is:inline>
  function initCourseCatalogEngine() {
    const searchInput = document.getElementById('course-search');
    const resetBtn = document.getElementById('reset-filters-btn');
    const categoryBtns = document.querySelectorAll('.category-filter-btn');
    const levelBtns = document.querySelectorAll('.level-filter-btn');
    const cards = Array.from(document.querySelectorAll('.course-card'));
    const noCoursesMsg = document.getElementById('no-courses-msg');
    const paginationControls = document.getElementById('pagination-controls');

    const prevBtn = document.getElementById('prev-page-btn');
    const nextBtn = document.getElementById('next-page-btn');
    const pageNumberBtnsContainer = document.getElementById('page-number-buttons');
    const itemStartEl = document.getElementById('page-item-start');
    const itemEndEl = document.getElementById('page-item-end');
    const totalFilteredEl = document.getElementById('total-filtered-count');

    if (!cards.length) return;

    const ITEMS_PER_PAGE = 4;
    let currentPage = 1;
    let selectedCategory = 'All';
    let selectedLevel = 'All';
    let searchQuery = '';
    let filteredCards = [...cards];

    function applyFilters() {
      filteredCards = cards.filter(card => {
        const title = card.getAttribute('data-title') || '';
        const desc = card.getAttribute('data-desc') || '';
        const category = card.getAttribute('data-category') || '';
        const level = card.getAttribute('data-level') || '';
        const tags = card.getAttribute('data-tags') || '';

        const matchesSearch = !searchQuery || title.includes(searchQuery) || desc.includes(searchQuery) || tags.includes(searchQuery);
        const matchesCategory = selectedCategory === 'All' || category === selectedCategory;
        const matchesLevel = selectedLevel === 'All' || level === selectedLevel;

        return matchesSearch && matchesCategory && matchesLevel;
      });

      currentPage = 1;
      renderPaginatedView();
    }

    function renderPaginatedView() {
      const totalItems = filteredCards.length;
      const totalPages = Math.ceil(totalItems / ITEMS_PER_PAGE) || 1;

      if (currentPage > totalPages) currentPage = totalPages;
      if (currentPage < 1) currentPage = 1;

      cards.forEach(card => card.style.display = 'none');

      const startIndex = (currentPage - 1) * ITEMS_PER_PAGE;
      const endIndex = Math.min(startIndex + ITEMS_PER_PAGE, totalItems);

      for (let i = startIndex; i < endIndex; i++) {
        if (filteredCards[i]) {
          filteredCards[i].style.display = 'flex';
        }
      }

      if (totalItems === 0) {
        noCoursesMsg?.classList.remove('hidden');
        paginationControls?.classList.add('hidden');
      } else {
        noCoursesMsg?.classList.add('hidden');
        paginationControls?.classList.remove('hidden');
      }

      if (itemStartEl) itemStartEl.textContent = totalItems === 0 ? '0' : (startIndex + 1).toString();
      if (itemEndEl) itemEndEl.textContent = endIndex.toString();
      if (totalFilteredEl) totalFilteredEl.textContent = totalItems.toString();

      if (prevBtn) prevBtn.disabled = currentPage === 1;
      if (nextBtn) nextBtn.disabled = currentPage === totalPages;

      if (pageNumberBtnsContainer) {
        pageNumberBtnsContainer.innerHTML = '';
        for (let p = 1; p <= totalPages; p++) {
          const btn = document.createElement('button');
          btn.type = 'button';
          btn.textContent = p.toString();
          btn.className = `w-7 h-7 rounded-lg text-xs font-mono font-bold transition-all cursor-pointer ${
            p === currentPage 
              ? 'bg-sky-600 text-white shadow-xs' 
              : 'border border-sky-100 dark:border-sky-900 bg-white dark:bg-slate-900 text-slate-700 dark:text-slate-300 hover:border-sky-400'
          }`;
          btn.onclick = () => {
            currentPage = p;
            renderPaginatedView();
            window.scrollTo({ top: document.getElementById('courses-grid')?.offsetTop - 100, behavior: 'smooth' });
          };
          pageNumberBtnsContainer.appendChild(btn);
        }
      }
    }

    searchInput?.addEventListener('input', (e) => {
      searchQuery = e.target.value.toLowerCase().trim();
      applyFilters();
    });

    categoryBtns.forEach(btn => {
      btn.addEventListener('click', () => {
        categoryBtns.forEach(b => {
          b.classList.remove('bg-sky-600', 'text-white', 'border-sky-600', 'shadow-sm');
          b.classList.add('bg-sky-50/60', 'dark:bg-slate-900', 'text-slate-700', 'dark:text-slate-300', 'border-sky-100', 'dark:border-sky-950');
        });
        btn.classList.remove('bg-sky-50/60', 'dark:bg-slate-900', 'text-slate-700', 'dark:text-slate-300', 'border-sky-100', 'dark:border-sky-950');
        btn.classList.add('bg-sky-600', 'text-white', 'border-sky-600', 'shadow-sm');

        selectedCategory = btn.getAttribute('data-category-btn') || 'All';
        applyFilters();
      });
    });

    levelBtns.forEach(btn => {
      btn.addEventListener('click', () => {
        levelBtns.forEach(b => {
          b.classList.remove('border-sky-500', 'bg-sky-500', 'text-white');
          b.classList.add('border-sky-100', 'dark:border-sky-950', 'bg-sky-50/40', 'dark:bg-slate-900', 'text-slate-600', 'dark:text-slate-400');
        });
        btn.classList.remove('border-sky-100', 'dark:border-sky-950', 'bg-sky-50/40', 'dark:bg-slate-900', 'text-slate-600', 'dark:text-slate-400');
        btn.classList.add('border-sky-500', 'bg-sky-500', 'text-white');

        selectedLevel = btn.getAttribute('data-level-btn') || 'All';
        applyFilters();
      });
    });

    resetBtn?.addEventListener('click', () => {
      if (searchInput) searchInput.value = '';
      searchQuery = '';
      selectedCategory = 'All';
      selectedLevel = 'All';

      categoryBtns.forEach((b, i) => {
        if (i === 0) {
          b.classList.add('bg-sky-600', 'text-white', 'border-sky-600');
          b.classList.remove('bg-sky-50/60', 'dark:bg-slate-900', 'text-slate-700', 'dark:text-slate-300');
        } else {
          b.classList.remove('bg-sky-600', 'text-white', 'border-sky-600');
          b.classList.add('bg-sky-50/60', 'dark:bg-slate-900', 'text-slate-700', 'dark:text-slate-300');
        }
      });

      levelBtns.forEach((b, i) => {
        if (i === 0) {
          b.classList.add('border-sky-500', 'bg-sky-500', 'text-white');
          b.classList.remove('border-sky-100', 'dark:border-sky-950', 'bg-sky-50/40', 'dark:bg-slate-900', 'text-slate-600');
        } else {
          b.classList.remove('border-sky-500', 'bg-sky-500', 'text-white');
          b.classList.add('border-sky-100', 'dark:border-sky-950', 'bg-sky-50/40', 'dark:bg-slate-900', 'text-slate-600');
        }
      });

      applyFilters();
    });

    prevBtn?.addEventListener('click', () => {
      if (currentPage > 1) {
        currentPage--;
        renderPaginatedView();
        window.scrollTo({ top: document.getElementById('courses-grid')?.offsetTop - 100, behavior: 'smooth' });
      }
    });

    nextBtn?.addEventListener('click', () => {
      const totalPages = Math.ceil(filteredCards.length / ITEMS_PER_PAGE);
      if (currentPage < totalPages) {
        currentPage++;
        renderPaginatedView();
        window.scrollTo({ top: document.getElementById('courses-grid')?.offsetTop - 100, behavior: 'smooth' });
      }
    });

    applyFilters();
  }

  initCourseCatalogEngine();
  document.addEventListener('astro:after-swap', initCourseCatalogEngine);
</script>