---
import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'astro:content';

const courses = await getCollection('courses');

// চেকআউট পেজের সেন্ট্রাল কনফিগারেশন
const DEFAULT_UPI_CONFIG = {
  upiId: 'imshibaji-3@okhdfcbank',
  upiName: 'Shibaji Debnath',
};

const GLOBAL_BANK_INFO = {
  accountName: 'Shibaji Debnath',
  bankName: 'HDFC Bank',
  accountNumber: '50200090860798',
  ifscCode: 'HDFC0000106',
  branch: 'Dum Dum Cantonment, Kolkata, West Bengal',
  accountType: 'Current'
};

// PayU গেটওয়ে ফি কনফিগারেশন (২% + ১৮% GST = ২.৩৬%)
const GATEWAY_SURCHARGE_PERCENT = 2.36; 

const courseCatalog = courses.map((c) => ({
  slug: c.id.replace(/\.md$/, ''),
  title: c.data.title,
  duration: c.data.duration,
  totalLessons: c.data.totalLessons,
  level: c.data.level,
  price: Number(c.data.price),
  originalPrice: Number(c.data.originalPrice ?? c.data.price),
  discountBadge: c.data.discountBadge ?? '',
  installmentPrice: Number(c.data.installmentPrice ?? 0),
  installmentPlanText: c.data.installmentPlanText ?? '',
  
  upiId: c.data.upi_id || DEFAULT_UPI_CONFIG.upiId,
  upiName: c.data.upi_name || DEFAULT_UPI_CONFIG.upiName,
  qrImageUrl: c.data.qr_image_url ?? '',
  customPaymentUrl: c.data.custom_payment_url ?? '',

  otherPaymentTitle: c.data.other_payment_title ?? 'International / Alternate Settlement',
  otherPaymentUrl: c.data.other_payment_url ?? '',
  otherPaymentNote: c.data.other_payment_note ?? 'Use for international cards or overseas accounts.',
  otherQrImage: c.data.other_qr_image ?? '',
  otherQrLabel: c.data.other_qr_label ?? 'Scan to remit via Alternate / Global Rails'
}));
---

<Layout title="Verified Payment Terminal — Shibaji Debnath">
  <div class="min-h-screen bg-slate-50 dark:bg-[#06080f] text-slate-900 dark:text-slate-200 py-12 px-4 sm:px-6 lg:px-8 transition-colors duration-300">
    <div class="max-w-5xl mx-auto">
      
      <!-- Top Navigation -->
      <div class="mb-8">
        <a 
          id="back_to_enquiry"
          href="/courses" 
          class="text-xs font-mono uppercase tracking-widest text-sky-700 dark:text-sky-400 hover:text-sky-600 dark:hover:text-sky-300 flex items-center gap-1 transition-colors"
        >
          &larr; Modify Registration / Candidate Profile
        </a>
        <h1 class="text-3xl sm:text-4xl font-black text-slate-950 dark:text-white tracking-tight mt-3">
          Verified Payment <span class="text-transparent bg-clip-text bg-gradient-to-r from-sky-600 to-indigo-600 dark:from-sky-400 dark:to-indigo-400">Terminal</span>
        </h1>
        <p class="text-sm text-slate-700 dark:text-slate-400 mt-2 max-w-2xl">
          Review your enrolled cohort details and select your preferred clearance channel.
        </p>
      </div>

      <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">
        
        <!-- Left Column: Checkout Methods & Channels -->
        <div class="lg:col-span-7 space-y-6">
          
          <!-- Candidate Identity Card -->
          <div class="bg-white dark:bg-[#0b101d]/90 border border-slate-200 dark:border-slate-800/80 rounded-2xl p-6 sm:p-8 backdrop-blur shadow-xl dark:shadow-2xl relative overflow-hidden transition-colors duration-300">
            <div class="absolute -right-8 -top-8 w-32 h-32 bg-sky-500/10 dark:bg-sky-500/5 rounded-full blur-2xl pointer-events-none"></div>

            <div class="flex items-center justify-between pb-6 border-b border-slate-200 dark:border-slate-800/60 mb-6 relative z-10">
              <span class="text-xs font-mono tracking-widest uppercase text-emerald-700 dark:text-emerald-400 flex items-center gap-2">
                <span class="h-2 w-2 rounded-full bg-emerald-600 dark:bg-emerald-400"></span>
                Verified Candidate Profile
              </span>
              <span class="text-xs font-mono text-slate-500 uppercase tracking-widest">Step 2 of 2</span>
            </div>

            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 text-xs font-mono relative z-10">
              <div class="p-3.5 rounded-xl bg-slate-50 dark:bg-[#070b14] border border-slate-200 dark:border-slate-800/60">
                <span class="block text-[10px] text-slate-500 uppercase">Enrolled Candidate</span>
                <span id="display_candidate_name" class="font-bold text-slate-950 dark:text-white text-sm mt-0.5 block truncate">--</span>
              </div>

              <div class="p-3.5 rounded-xl bg-slate-50 dark:bg-[#070b14] border border-slate-200 dark:border-slate-800/60">
                <span class="block text-[10px] text-slate-500 uppercase">Contact Email</span>
                <span id="display_candidate_email" class="font-bold text-slate-950 dark:text-white text-sm mt-0.5 block truncate">--</span>
              </div>

              <div class="p-3.5 rounded-xl bg-slate-50 dark:bg-[#070b14] border border-slate-200 dark:border-slate-800/60 sm:col-span-2 flex items-center justify-between gap-2">
                <div class="min-w-0">
                  <span class="block text-[10px] text-slate-500 uppercase">Registered WhatsApp</span>
                  <span id="display_candidate_phone" class="font-bold text-slate-950 dark:text-white text-sm mt-0.5 block truncate">--</span>
                </div>
                <span class="text-[10px] font-mono px-2 py-1 rounded bg-emerald-100 dark:bg-emerald-500/10 text-emerald-800 dark:text-emerald-400 border border-emerald-300 dark:border-emerald-500/20 whitespace-nowrap">
                  LOCKED
                </span>
              </div>
            </div>
          </div>

          <!-- Payment Channel Selection Tabs -->
          <div class="bg-white dark:bg-[#0b101d]/90 border border-slate-200 dark:border-slate-800/80 rounded-2xl p-6 sm:p-8 backdrop-blur shadow-xl dark:shadow-2xl space-y-6">
            
            <div>
              <span class="text-[11px] font-mono tracking-widest uppercase text-slate-500 dark:text-slate-400">Select Settlement Rail</span>
              <div class="grid grid-cols-2 sm:grid-cols-5 gap-2 mt-3 font-mono text-xs">
                <button type="button" data-tab="payu" class="channel-tab active-tab py-2.5 px-2 rounded-xl border border-sky-500 bg-sky-50 dark:bg-sky-950/40 text-sky-700 dark:text-sky-300 font-bold transition-all text-center cursor-pointer">
                  PayU
                </button>
                <button type="button" data-tab="upi" class="channel-tab py-2.5 px-2 rounded-xl border border-slate-200 dark:border-slate-800 bg-slate-50 dark:bg-slate-900/60 text-slate-600 dark:text-slate-400 hover:border-slate-400 font-medium transition-all text-center cursor-pointer">
                  Direct UPI
                </button>
                <button type="button" data-tab="qr" class="channel-tab py-2.5 px-2 rounded-xl border border-slate-200 dark:border-slate-800 bg-slate-50 dark:bg-slate-900/60 text-slate-600 dark:text-slate-400 hover:border-slate-400 font-medium transition-all text-center cursor-pointer">
                  Pay By QR
                </button>
                <button type="button" data-tab="netbanking" class="channel-tab py-2.5 px-2 rounded-xl border border-slate-200 dark:border-slate-800 bg-slate-50 dark:bg-slate-900/60 text-slate-600 dark:text-slate-400 hover:border-slate-400 font-medium transition-all text-center cursor-pointer">
                  NetBanking
                </button>
                <button type="button" id="tab_btn_other" data-tab="other" class="channel-tab hidden py-2.5 px-2 rounded-xl border border-amber-300 dark:border-amber-800 bg-amber-50 dark:bg-amber-950/30 text-amber-800 dark:text-amber-300 hover:border-amber-500 font-semibold transition-all text-center cursor-pointer">
                  Global / Other
                </button>
              </div>
            </div>

            <!-- Tab 1: PayU Automated Form -->
            <div id="tab_panel_payu" class="tab-panel space-y-6">
              <form id="checkout_gateway_form" class="space-y-6">
                <input type="hidden" name="course_id" id="pay_course_slug" value="" />
                <input type="hidden" name="course_title" id="pay_course_title" value="" />
                <input type="hidden" name="payment_plan" id="pay_payment_plan" value="full" />
                <input type="hidden" name="amount" id="pay_amount" value="0" />
                <input type="hidden" name="firstname" id="pay_full_name" value="" />
                <input type="hidden" name="email" id="pay_email" value="" />
                <input type="hidden" name="phone" id="pay_phone" value="" />

                <div class="flex items-center justify-between p-4 rounded-xl bg-sky-50 dark:bg-sky-950/20 border border-sky-200 dark:border-sky-500/30">
                  <div class="flex items-center gap-3">
                    <div class="w-9 h-9 rounded-lg bg-sky-100 dark:bg-sky-500/20 text-sky-700 dark:text-sky-400 flex items-center justify-center font-bold text-sm">
                      ⚡
                    </div>
                    <div>
                      <h4 class="text-sm font-bold text-slate-950 dark:text-white">Direct PayU Gateway</h4>
                      <p class="text-[11px] text-slate-600 dark:text-slate-400">Cards, UPI (GPay/PhonePe), NetBanking &amp; EMI</p>
                    </div>
                  </div>
                  <span class="text-[10px] font-mono text-sky-800 dark:text-sky-400 px-2.5 py-1 rounded bg-sky-100 dark:bg-sky-500/10 border border-sky-300 dark:border-sky-500/20 uppercase font-bold">
                    Automated
                  </span>
                </div>

                <div id="checkout_error_box" class="hidden p-4 rounded-xl bg-rose-50 dark:bg-rose-950/40 border border-rose-200 dark:border-rose-900/60 text-rose-700 dark:text-rose-300 text-xs font-mono">
                  <span id="checkout_error_text">Payment initiation error.</span>
                </div>

                <button 
                  type="submit" 
                  id="pay_btn"
                  class="w-full py-4 px-6 rounded-xl bg-gradient-to-r from-emerald-600 to-teal-700 dark:from-emerald-500 dark:to-teal-600 hover:from-emerald-500 hover:to-teal-600 dark:hover:from-emerald-400 dark:hover:to-teal-500 text-white font-bold text-base tracking-wide shadow-xl shadow-emerald-500/30 dark:shadow-emerald-500/20 transition-all flex items-center justify-center gap-3 cursor-pointer disabled:opacity-60 disabled:cursor-not-allowed"
                >
                  <span id="btn_action_label">Initiate Secure Transaction</span>
                  <span id="btn_amount_display" class="font-mono bg-black/20 dark:bg-black/30 px-2.5 py-1 rounded text-sm">₹0</span>
                  <span id="btn_arrow">&rarr;</span>
                </button>
              </form>
            </div>

            <!-- Tab 2: Direct UPI Manual Intent -->
            <div id="tab_panel_upi" class="tab-panel hidden space-y-4">
              <div class="p-5 rounded-2xl bg-slate-50 dark:bg-[#070b14] border border-slate-200 dark:border-slate-800/80 space-y-4 text-xs font-mono">
                <div>
                  <span class="text-[10px] text-slate-500 uppercase">Merchant VPA / UPI ID</span>
                  <div class="flex items-center justify-between mt-1 p-3 bg-white dark:bg-slate-900 rounded-xl border border-slate-200 dark:border-slate-800">
                    <span id="upi_id_text" class="font-bold text-slate-950 dark:text-white text-sm truncate">--</span>
                    <button type="button" id="copy_upi_btn" class="px-3 py-1 rounded bg-sky-100 dark:bg-sky-950 text-sky-700 dark:text-sky-300 hover:bg-sky-200 text-xs font-bold transition-all cursor-pointer">
                      Copy
                    </button>
                  </div>
                </div>

                <div>
                  <span class="text-[10px] text-slate-500 uppercase">Payee Name</span>
                  <p id="upi_name_text" class="font-bold text-slate-950 dark:text-white mt-0.5">--</p>
                </div>

                <a 
                  id="direct_upi_intent_link" 
                  href="#" 
                  class="block w-full py-3.5 rounded-xl bg-sky-600 hover:bg-sky-500 text-white text-center font-bold text-sm tracking-wide transition-all shadow-md shadow-sky-600/20"
                >
                  Open in UPI App (GPay / PhonePe / Paytm)
                </a>
              </div>
              <p class="text-[11px] text-slate-500 dark:text-slate-400 leading-relaxed font-mono">
                * কোনো বাড়তি চার্জ নেই (0% Surcharge)। পেমেন্টের পর স্ক্রিনশট ও UTR WhatsApp বা ইমেইলে পাঠান।
              </p>
            </div>

            <!-- Tab 3: Pay By QR Code -->
            <div id="tab_panel_qr" class="tab-panel hidden space-y-4 text-center">
              <div class="p-6 rounded-2xl bg-slate-50 dark:bg-[#070b14] border border-slate-200 dark:border-slate-800/80 flex flex-col items-center">
                <div class="p-3 bg-white rounded-2xl shadow-md border border-slate-200">
                  <img id="qr_image_display" src="" alt="UPI QR Code" class="w-48 h-48 object-contain rounded-lg" />
                </div>
                <p class="text-xs font-mono text-slate-700 dark:text-slate-300 mt-4 font-bold">
                  Scan to Pay <span id="qr_amount_display" class="text-emerald-600 dark:text-emerald-400">₹0</span>
                </p>
                <span class="text-[10px] font-mono text-slate-400 mt-1">GPay • PhonePe • Paytm • Zero Gateway Fee</span>
              </div>
            </div>

            <!-- Tab 4: NetBanking (NEFT / IMPS) -->
            <div id="tab_panel_netbanking" class="tab-panel hidden space-y-4">
              <div class="p-5 rounded-2xl bg-slate-50 dark:bg-[#070b14] border border-slate-200 dark:border-slate-800/80 space-y-2.5 text-xs font-mono">
                <div class="flex justify-between py-1 border-b border-slate-200 dark:border-slate-800">
                  <span class="text-slate-500">Account Name:</span>
                  <span class="font-bold text-slate-950 dark:text-white">{GLOBAL_BANK_INFO.accountName}</span>
                </div>
                <div class="flex justify-between py-1 border-b border-slate-200 dark:border-slate-800">
                  <span class="text-slate-500">Bank Name:</span>
                  <span class="font-bold text-slate-950 dark:text-white">{GLOBAL_BANK_INFO.bankName}</span>
                </div>
                <div class="flex justify-between py-1 border-b border-slate-200 dark:border-slate-800">
                  <span class="text-slate-500">Account Number:</span>
                  <span class="font-bold text-slate-950 dark:text-white">{GLOBAL_BANK_INFO.accountNumber}</span>
                </div>
                <div class="flex justify-between py-1 border-b border-slate-200 dark:border-slate-800">
                  <span class="text-slate-500">IFSC Code:</span>
                  <span class="font-bold text-emerald-600 dark:text-emerald-400">{GLOBAL_BANK_INFO.ifscCode}</span>
                </div>
                <div class="flex justify-between pt-1">
                  <span class="text-slate-500">Branch:</span>
                  <span class="text-slate-700 dark:text-slate-300">{GLOBAL_BANK_INFO.branch}</span>
                </div>
              </div>
            </div>

            <!-- Tab 5: International / Alternate Custom Payment Options -->
            <div id="tab_panel_other" class="tab-panel hidden space-y-5">
              <div id="other_link_box" class="hidden p-5 rounded-2xl bg-amber-50/50 dark:bg-amber-950/20 border border-amber-200 dark:border-amber-900/60 space-y-3">
                <div class="flex items-center justify-between">
                  <h4 id="other_title_text" class="text-xs font-bold font-mono text-amber-900 dark:text-amber-300 uppercase">
                    International Gateway Link
                  </h4>
                  <span class="text-[10px] font-mono px-2 py-0.5 rounded bg-amber-100 dark:bg-amber-900/50 text-amber-800 dark:text-amber-300 font-bold">
                    Global Rails
                  </span>
                </div>
                <p id="other_note_text" class="text-xs text-slate-600 dark:text-slate-400 leading-relaxed font-mono">
                  Direct clearance portal for non-INR currencies or corporate cards.
                </p>
                <a 
                  id="other_direct_url_btn" 
                  href="#" 
                  target="_blank" 
                  rel="noopener noreferrer" 
                  class="inline-flex items-center justify-center gap-2 w-full py-3 px-4 rounded-xl bg-amber-600 hover:bg-amber-500 text-white font-mono font-bold text-xs shadow-md shadow-amber-600/20 transition-all cursor-pointer"
                >
                  Proceed to Global Clearance Portal &rarr;
                </a>
              </div>

              <div id="other_qr_box" class="hidden p-5 rounded-2xl bg-slate-50 dark:bg-[#070b14] border border-slate-200 dark:border-slate-800/80 text-center space-y-3">
                <span id="other_qr_label_text" class="text-xs font-mono font-bold text-slate-700 dark:text-slate-300 uppercase block">
                  Scan Alternate Remittance QR
                </span>
                <div class="inline-block p-3 bg-white rounded-2xl shadow-md border border-slate-200">
                  <img id="other_qr_image_display" src="" alt="Alternate Remittance QR" class="w-44 h-44 object-contain rounded-lg mx-auto" />
                </div>
              </div>
            </div>

            <div class="flex items-center justify-center gap-6 text-slate-500 dark:text-slate-500 text-xs font-mono pt-2 flex-wrap">
              <span class="flex items-center gap-1">🔒 256-Bit SSL</span>
              <span class="flex items-center gap-1">🛡️ SHA-512 Signed</span>
              <span class="flex items-center gap-1">⚡ Instant Invoicing</span>
            </div>

          </div>

        </div>

        <!-- Right Column: Line-Item Order Invoice Breakdown -->
        <div class="lg:col-span-5 bg-white dark:bg-[#0b101d]/90 border border-slate-200 dark:border-slate-800/80 rounded-2xl p-6 sm:p-8 backdrop-blur shadow-xl dark:shadow-2xl space-y-6 sticky top-8 transition-colors duration-300">
          
          <div class="pb-5 border-b border-slate-200 dark:border-slate-800/60">
            <span class="text-[11px] font-mono tracking-widest uppercase text-slate-500 dark:text-slate-400">Enrolled Program</span>
            <h2 id="invoice_course_title" class="text-lg sm:text-xl font-black text-slate-950 dark:text-white mt-1 leading-snug">
              Loading Cohort...
            </h2>
            <div class="flex flex-wrap items-center gap-2 mt-3 font-mono text-[11px]">
              <span id="invoice_badge_duration" class="px-2.5 py-1 rounded-md bg-sky-100 dark:bg-sky-950/60 text-sky-800 dark:text-sky-400 border border-sky-200 dark:border-sky-800/40">--</span>
              <span id="invoice_badge_lessons" class="px-2.5 py-1 rounded-md bg-indigo-100 dark:bg-indigo-950/60 text-indigo-800 dark:text-indigo-400 border border-indigo-200 dark:border-indigo-800/40">--</span>
              <span id="invoice_badge_level" class="px-2.5 py-1 rounded-md bg-slate-100 dark:bg-slate-800 text-slate-700 dark:text-slate-300 border border-slate-200 dark:border-slate-700/50">--</span>
            </div>
          </div>

          <!-- Billing Line Items -->
          <div class="space-y-3.5 text-xs text-slate-700 dark:text-slate-300">
            <div class="flex justify-between items-center py-1">
              <span class="text-slate-500 dark:text-slate-400">Tuition Standard Rate</span>
              <span id="invoice_original_rate" class="font-mono line-through text-slate-400 dark:text-slate-500">₹0</span>
            </div>
            <div class="flex justify-between items-center py-1">
              <span class="text-slate-500 dark:text-slate-400">Payment Milestone Structure</span>
              <span id="invoice_plan_type" class="font-mono font-medium text-slate-950 dark:text-white">Full Cohort Access</span>
            </div>
            <div class="flex justify-between items-center py-1">
              <span class="text-slate-500 dark:text-slate-400">Tuition Scholarship / Waiver</span>
              <span id="invoice_scholarship_discount" class="font-mono text-emerald-700 dark:text-emerald-400 font-semibold">-₹0</span>
            </div>

            <!-- 👈 ডাইনামিক গেটওয়ে সারচার্জ ফিল্ড -->
            <div class="flex justify-between items-center py-1 border-t border-dashed border-slate-200 dark:border-slate-800 pt-2">
              <span class="text-slate-500 dark:text-slate-400">
                Gateway Processing Fee <span id="surcharge_badge" class="text-[10px] text-sky-600 dark:text-sky-400 font-mono">(2.36%)</span>
              </span>
              <span id="invoice_gateway_fee" class="font-mono font-semibold text-slate-800 dark:text-slate-200">₹0.00</span>
            </div>
          </div>

          <!-- Total Invoice Due Section -->
          <div class="pt-5 border-t border-slate-200 dark:border-slate-800/80 flex items-baseline justify-between">
            <div>
              <span class="block text-xs font-mono uppercase tracking-wider text-slate-500 dark:text-slate-400">Total Net Payable</span>
              <span class="text-[10px] text-slate-400 dark:text-slate-500" id="total_guarantee_label">Includes gateway surcharge</span>
            </div>
            <div class="text-right">
              <span id="invoice_final_amount" class="text-2xl sm:text-3xl font-black text-sky-700 dark:text-sky-400 font-mono">₹0</span>
              <span class="block text-[10px] font-mono text-slate-400 dark:text-slate-500">INR TOTAL</span>
            </div>
          </div>

        </div>

      </div>
    </div>
  </div>

  <!-- Client-Side Tabs, Gateway Calculator & Handler -->
  <script define:vars={{ courseCatalog, DEFAULT_UPI_CONFIG, GATEWAY_SURCHARGE_PERCENT }}>
    function initCheckoutPage() {
      const params = new URLSearchParams(window.location.search);
      const courseSlug = params.get('course');
      const plan = (params.get('plan') || 'full').toLowerCase();
      const name = params.get('name') || '';
      const email = params.get('email') || '';
      const phone = params.get('phone') || '';

      const course = courseCatalog.find((c) => c.slug === courseSlug) || courseCatalog[0];
      if (!course) return;

      const isInstallment = plan === 'installment' && course.installmentPrice > 0;
      const baseAmount = isInstallment ? course.installmentPrice : course.price;
      const planLabel = isInstallment ? 'Milestone Split Installment' : 'Full Cohort Access';
      const savings = Math.max(0, course.originalPrice - baseAmount);

      let currentSelectedRail = 'payu';

      // ক্যান্ডিডেট ডেটা ভিউ
      document.getElementById('display_candidate_name').textContent = name || 'Candidate';
      document.getElementById('display_candidate_email').textContent = email || 'Unspecified';
      document.getElementById('display_candidate_phone').textContent = phone || 'Unspecified';

      // ইনভয়েস ভিউ
      document.getElementById('invoice_course_title').textContent = course.title;
      document.getElementById('invoice_badge_duration').textContent = course.duration;
      document.getElementById('invoice_badge_lessons').textContent = `${course.totalLessons} Lessons`;
      document.getElementById('invoice_badge_level').textContent = course.level;
      document.getElementById('invoice_original_rate').textContent = `₹${course.originalPrice.toLocaleString('en-IN')}`;
      document.getElementById('invoice_plan_type').textContent = planLabel;
      document.getElementById('invoice_scholarship_discount').textContent = `-₹${savings.toLocaleString('en-IN')}`;

      // গেটওয়ে ফি ও ফাইনাল ভ্যালু ক্যালকুলেটর ফাংশন
      function updateFinancials(rail) {
        currentSelectedRail = rail;
        let surcharge = 0;

        if (rail === 'payu') {
          // ২.৩৬% গেটওয়ে ফি
          surcharge = Math.round((baseAmount * (GATEWAY_SURCHARGE_PERCENT / 100)) * 100) / 100;
          document.getElementById('invoice_gateway_fee').textContent = `+₹${surcharge.toFixed(2)}`;
          document.getElementById('invoice_gateway_fee').className = "font-mono font-semibold text-rose-600 dark:text-rose-400";
          document.getElementById('surcharge_badge').textContent = `(${GATEWAY_SURCHARGE_PERCENT}%)`;
          document.getElementById('total_guarantee_label').textContent = "Includes PayU surcharge";
        } else {
          // UPI, QR, NetBanking এ কোনো গেটওয়ে ফি নেই
          surcharge = 0;
          document.getElementById('invoice_gateway_fee').textContent = "Waived (₹0.00)";
          document.getElementById('invoice_gateway_fee').className = "font-mono font-semibold text-emerald-600 dark:text-emerald-400";
          document.getElementById('surcharge_badge').textContent = "(Direct Rail)";
          document.getElementById('total_guarantee_label').textContent = "Zero Gateway Surcharge";
        }

        const totalPayable = Math.round((baseAmount + surcharge) * 100) / 100;

        // ইনভয়েস টোটাল ও বাটন অ্যামাউন্ট আপডেট
        document.getElementById('invoice_final_amount').textContent = `₹${totalPayable.toLocaleString('en-IN')}`;
        document.getElementById('btn_amount_display').textContent = `₹${totalPayable.toLocaleString('en-IN')}`;
        document.getElementById('pay_amount').value = totalPayable; // সাবমিটের জন্য পাস করা
      }

      // প্রাথমিক ক্যালকুলেশন (ডিফল্ট PayU)
      updateFinancials('payu');

      // হিডেন ফিল্ড পপুলেট
      document.getElementById('pay_course_slug').value = course.slug;
      document.getElementById('pay_course_title').value = course.title;
      document.getElementById('pay_payment_plan').value = plan;
      document.getElementById('pay_full_name').value = name;
      document.getElementById('pay_email').value = email;
      document.getElementById('pay_phone').value = phone;

      // UPI রেজোলিউশন
      const upiId = course.upiId || DEFAULT_UPI_CONFIG.upiId;
      const upiName = course.upiName || DEFAULT_UPI_CONFIG.upiName;
      document.getElementById('upi_id_text').textContent = upiId;
      document.getElementById('upi_name_text').textContent = upiName;

      // UPI Intent Link (সরাসরি বেস মূল্যে চার্জ করবে, কোনো সারচার্জ ছাড়া)
      const cleanCourseTitle = encodeURIComponent(course.title.slice(0, 30));
      const upiUri = `upi://pay?pa=${encodeURIComponent(upiId)}&pn=${encodeURIComponent(upiName)}&am=${baseAmount}&cu=INR&tn=${cleanCourseTitle}`;
      document.getElementById('direct_upi_intent_link').href = upiUri;

      // QR Code রেজোলিউশন
      const qrImageEl = document.getElementById('qr_image_display');
      document.getElementById('qr_amount_display').textContent = `₹${baseAmount.toLocaleString('en-IN')}`;
      if (course.qrImageUrl) {
        qrImageEl.src = course.qrImageUrl;
      } else {
        qrImageEl.src = `https://api.qrserver.com/v1/create-qr-code/?size=250x250&data=${encodeURIComponent(upiUri)}`;
      }

      // অন্যান্য পেমেন্ট লিঙ্ক হ্যান্ডলার
      const otherTabBtn = document.getElementById('tab_btn_other');
      const otherLinkBox = document.getElementById('other_link_box');
      const otherQrBox = document.getElementById('other_qr_box');
      const otherDirectUrlBtn = document.getElementById('other_direct_url_btn');
      const otherTitleText = document.getElementById('other_title_text');
      const otherNoteText = document.getElementById('other_note_text');
      const otherQrImageDisplay = document.getElementById('other_qr_image_display');
      const otherQrLabelText = document.getElementById('other_qr_label_text');

      const hasOtherUrl = Boolean(course.otherPaymentUrl || course.customPaymentUrl);
      const hasOtherQr = Boolean(course.otherQrImage);

      if (hasOtherUrl || hasOtherQr) {
        otherTabBtn.classList.remove('hidden');
        if (hasOtherUrl) {
          otherLinkBox.classList.remove('hidden');
          otherDirectUrlBtn.href = course.otherPaymentUrl || course.customPaymentUrl;
          if (course.otherPaymentTitle) otherTitleText.textContent = course.otherPaymentTitle;
          if (course.otherPaymentNote) otherNoteText.textContent = course.otherPaymentNote;
        } else {
          otherLinkBox.classList.add('hidden');
        }

        if (hasOtherQr) {
          otherQrBox.classList.remove('hidden');
          otherQrImageDisplay.src = course.otherQrImage;
          if (course.otherQrLabel) otherQrLabelText.textContent = course.otherQrLabel;
        } else {
          otherQrBox.classList.add('hidden');
        }
      } else {
        otherTabBtn.classList.add('hidden');
      }

      // কপি বাটন
      const copyBtn = document.getElementById('copy_upi_btn');
      if (copyBtn) {
        copyBtn.onclick = () => {
          navigator.clipboard.writeText(upiId);
          copyBtn.textContent = 'Copied!';
          setTimeout(() => {
            copyBtn.textContent = 'Copy';
          }, 2000);
        };
      }

      // ট্যাব সুইচিং এবং অটো-ক্যালকুলেশন ট্রিগার
      const tabs = document.querySelectorAll('.channel-tab');
      const panels = document.querySelectorAll('.tab-panel');
      tabs.forEach((tab) => {
        tab.addEventListener('click', () => {
          const selectedRail = tab.dataset.tab;

          tabs.forEach((t) => {
            t.classList.remove('active-tab', 'border-sky-500', 'bg-sky-50', 'dark:bg-sky-950/40', 'text-sky-700', 'dark:text-sky-300', 'font-bold');
            t.classList.add('border-slate-200', 'dark:border-slate-800', 'bg-slate-50', 'dark:bg-slate-900/60', 'text-slate-600', 'dark:text-slate-400');
          });
          tab.classList.add('active-tab', 'border-sky-500', 'bg-sky-50', 'dark:bg-sky-950/40', 'text-sky-700', 'dark:text-sky-300', 'font-bold');

          panels.forEach((p) => p.classList.add('hidden'));
          const activePanel = document.getElementById(`tab_panel_${selectedRail}`);
          if (activePanel) activePanel.classList.remove('hidden');

          // নির্বাচিত চ্যানেলের ওপর ভিত্তি করে ফাইনাল ক্যালকুলেশন
          updateFinancials(selectedRail);
        });
      });

      // PayU গেটওয়ে সাবমিট হ্যান্ডলার
      const form = document.getElementById('checkout_gateway_form');
      const payBtn = document.getElementById('pay_btn');
      const btnActionLabel = document.getElementById('btn_action_label');
      const errorBox = document.getElementById('checkout_error_box');
      const errorText = document.getElementById('checkout_error_text');

      if (form && !form.dataset.initialized) {
        form.dataset.initialized = 'true';
        form.addEventListener('submit', async function (e) {
          e.preventDefault();
          if (errorBox) errorBox.classList.add('hidden');
          if (payBtn) payBtn.disabled = true;
          btnActionLabel.textContent = 'Securing Gateway Session...';

          try {
            const formData = new FormData(form);
            const payload = Object.fromEntries(formData.entries());

            const res = await fetch('/api/payu/init.php', {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify(payload)
            });

            const data = await res.json();

            if (data.status === 'success') {
              if (data.is_free) {
                window.location.href = data.redirect_url;
                return;
              }

              const payuForm = document.createElement('form');
              payuForm.method = 'POST';
              payuForm.action = data.action;

              for (const [key, val] of Object.entries(data.params)) {
                const input = document.createElement('input');
                input.type = 'hidden';
                input.name = key;
                input.value = String(val);
                payuForm.appendChild(input);
              }

              document.body.appendChild(payuForm);
              payuForm.submit();
            } else {
              if (errorText) errorText.textContent = data.message || 'Payment initiation failed.';
              if (errorBox) errorBox.classList.remove('hidden');
              if (payBtn) payBtn.disabled = false;
              btnActionLabel.textContent = 'Initiate Secure Transaction';
            }
          } catch (err) {
            if (errorText) errorText.textContent = 'Network error. Please check server status.';
            if (errorBox) errorBox.classList.remove('hidden');
            if (payBtn) payBtn.disabled = false;
            btnActionLabel.textContent = 'Initiate Secure Transaction';
          }
        });
      }
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initCheckoutPage);
    } else {
      initCheckoutPage();
    }
    document.addEventListener('astro:page-load', initCheckoutPage);
  </script>
</Layout>