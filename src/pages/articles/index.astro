---
import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'astro:content';

const articles = await getCollection('articles');
articles.sort((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime());

// Unique Categories and Tags
const allCategories = ["All", ...new Set(articles.map(art => art.data.category || "Architecture"))];
const allTags = [...new Set(articles.flatMap(art => art.data.tags || []))];

// YouTube Thumbnail Extractor (with MaxRes fallback)
function getArticleThumbnail(art: any) {
  if (art.data.featuredImage) return art.data.featuredImage;
  if (art.data.videoUrl) {
    const match = art.data.videoUrl.match(/(?:embed\/|v=|vi\/|youtu\.be\/|\/v\/)([^#&?]*).*/);
    const videoId = (match && match[1]) ? match[1] : null;
    if (videoId) return `https://img.youtube.com/vi/${videoId}/maxresdefault.jpg`;
  }
  return "/profile.png";
}

const listSchema = {
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  "name": "Engineering Articles & System Architecture Blueprints | Shibaji Debnath",
  "description": "Technical write-ups, real-world case studies, and hands-on video tutorials on distributed systems and AI workflows.",
  "hasPart": articles.map(art => ({
    "@type": "TechArticle",
    "headline": art.data.title,
    "description": art.data.description,
    "url": `https://shibajidebnath.com/articles/${art.id}`,
    "datePublished": art.data.pubDate.toISOString(),
    "keywords": (art.data.tags || []).join(", ")
  }))
};
---

<Layout 
  title="Engineering Insights & Video Blueprints | Shibaji Debnath"
  description="Deep-dive articles and video walkthroughs on building scalable distributed architectures and autonomous AI pipelines."
>
  <script type="application/ld+json" set:html={JSON.stringify(listSchema)} slot="head" />

  <!-- Background Decorative Canvas Elements -->
  <div class="relative overflow-hidden min-h-screen">
    
    <!-- Ambient Glow Drops -->
    <div class="absolute top-10 left-1/2 -translate-x-1/2 w-[850px] h-[380px] bg-gradient-to-tr from-sky-400/15 via-cyan-400/10 to-transparent dark:from-sky-600/20 dark:via-sky-400/10 blur-[130px] rounded-full pointer-events-none -z-10"></div>
    <div class="absolute top-96 right-[-100px] w-96 h-96 bg-sky-200/30 dark:bg-sky-900/10 blur-[100px] rounded-full pointer-events-none -z-10"></div>

    <div class="py-14 sm:py-20 max-w-7xl mx-auto px-6">
      
      <!-- Modern Headline Header -->
      <header class="max-w-5xl mb-12 sm:mb-16">
        <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full border border-sky-200 dark:border-sky-850/80 bg-white/80 dark:bg-sky-950/40 backdrop-blur-md text-xs font-mono font-bold text-sky-700 dark:text-sky-300 mb-5 shadow-xs">
          <span class="w-2 h-2 rounded-full bg-sky-500 animate-ping"></span>
          Engineering Knowledge Hub
        </div>
        
        <h1 class="text-4xl sm:text-5xl lg:text-6xl font-black text-slate-900 dark:text-white tracking-tight leading-[1.12]">
          Architecture <span class="text-transparent bg-clip-text bg-gradient-to-r from-sky-600 via-cyan-500 to-sky-400">Blueprints</span> & Insights.
        </h1>
        
        <p class="text-base sm:text-lg text-slate-600 dark:text-slate-300 mt-4 leading-relaxed max-w-2xl font-normal">
          Field-tested architectural decision records (ADRs), full-stack microservice breakdowns, and zero-cost AI automations.
        </p>
      </header>

      <!-- Glassmorphic Filter & Live Search Toolbar -->
      <section class="p-4 sm:p-6 rounded-3xl border border-sky-200/80 dark:border-sky-900/50 bg-white/70 dark:bg-[#070e1c]/70 backdrop-blur-xl shadow-xl shadow-sky-950/5 mb-14 space-y-5">
        
        <!-- Live Search Field -->
        <div class="relative">
          <div class="absolute inset-y-0 left-0 pl-4 flex items-center pointer-events-none text-sky-500">
            <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
            </svg>
          </div>
          <input 
            type="text" 
            id="article-search" 
            placeholder="Search blueprints by keyword, framework, or concept (e.g. n8n, Docker, Redis)..." 
            class="w-full pl-12 pr-4 py-3.5 rounded-2xl border border-sky-100 dark:border-sky-900/80 bg-white dark:bg-slate-900/70 text-slate-900 dark:text-white placeholder:text-slate-400 focus:outline-none focus:border-sky-500 focus:ring-2 focus:ring-sky-500/20 transition-all text-sm font-medium shadow-inner"
          />
        </div>

        <!-- Filter Controls: Categories & Tags Combined -->
        <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 pt-1">
          
          <!-- Categories Bar -->
          <div class="flex flex-wrap items-center gap-2">
            <span class="text-[11px] font-mono uppercase tracking-wider text-slate-400 font-bold mr-1">Category:</span>
            {allCategories.map((cat, idx) => (
              <button 
                type="button" 
                data-category-btn={cat} 
                class={`category-filter-btn px-3.5 py-1.5 rounded-xl text-xs font-mono font-bold transition-all cursor-pointer border ${idx === 0 ? 'bg-sky-600 text-white border-sky-600 shadow-md shadow-sky-600/25' : 'bg-white dark:bg-slate-900 text-slate-600 dark:text-slate-300 border-sky-100 dark:border-sky-950 hover:border-sky-400'}`}
              >
                {cat}
              </button>
            ))}
          </div>

          <!-- Tags Quick Pills -->
          <div class="flex flex-wrap items-center gap-1.5">
            <span class="text-[11px] font-mono uppercase tracking-wider text-slate-400 font-bold mr-1">Tags:</span>
            <button 
              type="button" 
              data-tag-btn="all"
              class="tag-filter-btn active text-[11px] font-mono px-2.5 py-1 rounded-lg border border-sky-500 bg-sky-500 text-white transition-all cursor-pointer"
            >
              #All
            </button>
            {allTags.slice(0, 5).map((tag) => (
              <button 
                type="button" 
                data-tag-btn={tag}
                class="tag-filter-btn text-[11px] font-mono px-2.5 py-1 rounded-lg border border-sky-100 dark:border-sky-950 bg-white/80 dark:bg-slate-900 text-slate-500 dark:text-slate-400 hover:border-sky-400 hover:text-sky-600 transition-all cursor-pointer"
              >
                #{tag}
              </button>
            ))}
          </div>

        </div>

      </section>

      <!-- Articles Grid Cards -->
      <div id="articles-grid" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
        {articles.map((art) => {
          const thumb = getArticleThumbnail(art);
          const category = art.data.category || "Architecture";
          const tags = art.data.tags || [];
          const hasVideo = !!art.data.videoUrl;

          return (
            <article 
              class="article-card group relative rounded-3xl p-5 bg-white/80 dark:bg-[#070e1c]/80 backdrop-blur-md border border-sky-100 dark:border-sky-900/60 hover:border-sky-400/80 dark:hover:border-sky-500/70 shadow-sm hover:shadow-2xl hover:shadow-sky-500/10 hover:-translate-y-1.5 transition-all duration-300 flex flex-col justify-between"
              data-title={art.data.title.toLowerCase()}
              data-desc={art.data.description.toLowerCase()}
              data-category={category}
              data-tags={tags.join(",").toLowerCase()}
            >
              
              <!-- Subtle card top glow on hover -->
              <div class="absolute inset-x-8 top-0 h-px bg-gradient-to-r from-transparent via-sky-400 to-transparent opacity-0 group-hover:opacity-100 transition-opacity"></div>

              <div>
                <!-- Visual Thumbnail Media Frame -->
                <a href={`/articles/${art.id}`} class="block relative w-full aspect-video rounded-2xl overflow-hidden mb-5 bg-slate-950 border border-sky-100 dark:border-sky-950 shadow-inner group/thumb">
                  
                  <img 
                    src={thumb} 
                    alt={art.data.title}
                    class="w-full h-full object-cover group-hover/thumb:scale-105 transition-transform duration-500"
                    loading="lazy"
                  />

                  <!-- Floating Badges on Thumbnail -->
                  <div class="absolute top-3 left-3 flex items-center gap-1.5 z-10">
                    <span class="text-[10px] font-mono font-bold uppercase tracking-wider px-2.5 py-1 rounded-md bg-slate-950/80 text-sky-300 backdrop-blur-md border border-sky-500/30 shadow-xs">
                      {category}
                    </span>
                  </div>

                  <!-- Play Button Badge if Video -->
                  {hasVideo && (
                    <div class="absolute inset-0 bg-black/25 group-hover/thumb:bg-black/10 transition-colors flex items-center justify-center">
                      <div class="w-12 h-12 rounded-2xl bg-white/90 dark:bg-slate-900/90 text-red-600 flex items-center justify-center shadow-xl border border-white/20 backdrop-blur-md transform group-hover/thumb:scale-110 transition-transform duration-300">
                        <svg class="w-5 h-5 fill-current ml-0.5" viewBox="0 0 24 24">
                          <path d="M8 5v14l11-7z" />
                        </svg>
                      </div>
                      <span class="absolute bottom-2.5 right-2.5 px-2 py-0.5 rounded text-[10px] font-mono font-bold bg-black/80 text-white tracking-wide">
                        VIDEO
                      </span>
                    </div>
                  )}
                </a>

                <!-- Meta Line -->
                <div class="flex items-center gap-2 text-xs font-mono text-slate-500 dark:text-slate-400 mb-2.5">
                  <span class="text-sky-600 dark:text-sky-400 font-semibold">{art.data.readingTime || "8 min read"}</span>
                  <span>•</span>
                  <time datetime={art.data.pubDate.toISOString()}>
                    {art.data.pubDate.toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' })}
                  </time>
                </div>

                <!-- Title Link -->
                <h2 class="text-xl font-extrabold text-slate-900 dark:text-white group-hover:text-sky-600 dark:group-hover:text-sky-400 transition-colors line-clamp-2 leading-snug tracking-tight">
                  <a href={`/articles/${art.id}`} class="focus:outline-none">
                    {art.data.title}
                  </a>
                </h2>

                <!-- Description -->
                <p class="text-sm text-slate-600 dark:text-slate-300 mt-2.5 leading-relaxed line-clamp-3 font-normal">
                  {art.data.description}
                </p>
              </div>

              <!-- Card Bottom Footer -->
              <div class="pt-5 mt-6 border-t border-sky-100 dark:border-sky-950/80">
                <div class="flex flex-wrap gap-1.5 mb-4">
                  {tags.slice(0, 3).map((t) => (
                    <span class="text-[11px] font-mono px-2 py-0.5 rounded-md bg-sky-50 dark:bg-slate-900 text-sky-800 dark:text-sky-300 border border-sky-200/60 dark:border-sky-900/60">
                      #{t}
                    </span>
                  ))}
                </div>

                <a 
                  href={`/articles/${art.id}`} 
                  class="inline-flex items-center gap-2 text-xs font-mono font-bold text-sky-600 dark:text-sky-400 group-hover:gap-3 transition-all"
                >
                  <span>Explore Blueprint</span>
                  <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M14 5l7 7m0 0l-7 7m7-7H3"/>
                  </svg>
                </a>
              </div>

            </article>
          );
        })}
      </div>

      <!-- Empty State Indicator -->
      <div id="no-articles-msg" class="hidden py-24 text-center">
        <div class="w-16 h-16 mx-auto rounded-2xl bg-sky-50 dark:bg-sky-950/60 border border-sky-200 dark:border-sky-900 text-sky-600 dark:text-sky-400 flex items-center justify-center mb-4 shadow-sm">
          <svg class="w-7 h-7" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.172 16.172a4 4 0 015.656 0M9 10h.01M15 10h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>
          </svg>
        </div>
        <h3 class="text-lg font-bold text-slate-900 dark:text-white">No blueprints match your filter</h3>
        <p class="text-xs font-mono text-slate-500 dark:text-slate-400 mt-1">Try resetting the search terms or clearing the selected category.</p>
      </div>

    </div>
  </div>
</Layout>

<!-- Client Filtering & Search Logic -->
<script is:inline>
  function setupArticleFilters() {
    const searchInput = document.getElementById('article-search');
    const categoryBtns = document.querySelectorAll('.category-filter-btn');
    const tagBtns = document.querySelectorAll('.tag-filter-btn');
    const cards = document.querySelectorAll('.article-card');
    const noArticlesMsg = document.getElementById('no-articles-msg');

    if (!cards.length) return;

    let selectedCategory = 'All';
    let selectedTag = 'all';
    let searchQuery = '';

    function filterCards() {
      let visibleCount = 0;

      cards.forEach(card => {
        const title = card.getAttribute('data-title') || '';
        const desc = card.getAttribute('data-desc') || '';
        const category = card.getAttribute('data-category') || '';
        const tags = card.getAttribute('data-tags') || '';

        const matchesSearch = !searchQuery || title.includes(searchQuery) || desc.includes(searchQuery) || tags.includes(searchQuery);
        const matchesCategory = selectedCategory === 'All' || category === selectedCategory;
        const matchesTag = selectedTag === 'all' || tags.split(',').map(t => t.trim()).includes(selectedTag.toLowerCase());

        if (matchesSearch && matchesCategory && matchesTag) {
          card.style.display = 'flex';
          visibleCount++;
        } else {
          card.style.display = 'none';
        }
      });

      if (noArticlesMsg) {
        if (visibleCount === 0) {
          noArticlesMsg.classList.remove('hidden');
        } else {
          noArticlesMsg.classList.add('hidden');
        }
      }
    }

    searchInput?.addEventListener('input', (e) => {
      searchQuery = e.target.value.toLowerCase().trim();
      filterCards();
    });

    categoryBtns.forEach(btn => {
      btn.addEventListener('click', () => {
        categoryBtns.forEach(b => {
          b.classList.remove('bg-sky-600', 'text-white', 'border-sky-600', 'shadow-md');
          b.classList.add('bg-white', 'dark:bg-slate-900', 'text-slate-600', 'dark:text-slate-300', 'border-sky-100', 'dark:border-sky-950');
        });
        btn.classList.remove('bg-white', 'dark:bg-slate-900', 'text-slate-600', 'dark:text-slate-300', 'border-sky-100', 'dark:border-sky-950');
        btn.classList.add('bg-sky-600', 'text-white', 'border-sky-600', 'shadow-md');

        selectedCategory = btn.getAttribute('data-category-btn') || 'All';
        filterCards();
      });
    });

    tagBtns.forEach(btn => {
      btn.addEventListener('click', () => {
        tagBtns.forEach(b => {
          b.classList.remove('border-sky-500', 'bg-sky-500', 'text-white');
          b.classList.add('border-sky-100', 'dark:border-sky-950', 'bg-white/80', 'dark:bg-slate-900', 'text-slate-500', 'dark:text-slate-400');
        });
        btn.classList.remove('border-sky-100', 'dark:border-sky-950', 'bg-white/80', 'dark:bg-slate-900', 'text-slate-500', 'dark:text-slate-400');
        btn.classList.add('border-sky-500', 'bg-sky-500', 'text-white');

        selectedTag = btn.getAttribute('data-tag-btn') || 'all';
        filterCards();
      });
    });
  }

  setupArticleFilters();
  document.addEventListener('astro:after-swap', setupArticleFilters);
</script>