---
import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'astro:content';

const courses = await getCollection('courses');

const url = new URL(Astro.request.url);
const selectedCourseSlug = url.searchParams.get('course') || (courses[0] ? courses[0].id : '');
const planParam = url.searchParams.get('plan');
const initialPlan = planParam === 'installment' ? 'installment' : 'full';

const studentName = url.searchParams.get('name') || '';
const studentEmail = url.searchParams.get('email') || '';
const studentPhone = url.searchParams.get('phone') || '';

const course = courses.find(c => c.id === selectedCourseSlug) || courses[0];

const currency = course?.data.currency || "₹";
const price = Number(course?.data.price ?? 0);
const originalPrice = Number(course?.data.originalPrice ?? 0);
const installmentPrice = Number(course?.data.installmentPrice ?? (price > 0 ? Math.round(price / 4) : 0));
const hasInstallment = installmentPrice > 0 && price > 0;
const isFree = price === 0;

const payableAmount = (!isFree && initialPlan === 'installment' && hasInstallment) ? installmentPrice : price;
const planLabel = isFree ? "Free Direct Access" : (initialPlan === 'installment' && hasInstallment ? "Quarterly Milestone (1 of 4)" : "Full 1-Year Mentorship");
---

<Layout 
  title={`Payment Terminal - ${course ? course.data.title : 'Course'} | Shibaji Debnath`}
  description="Complete secure payment for verified cohort application."
>
  <div class="relative min-h-screen py-12 lg:py-18">
    <div class="absolute top-0 left-1/2 -translate-x-1/2 w-[700px] h-[300px] bg-gradient-to-tr from-sky-400/15 via-cyan-400/10 to-transparent dark:from-sky-600/20 dark:via-sky-400/10 blur-[130px] rounded-full pointer-events-none -z-10"></div>

    <div class="max-w-5xl mx-auto px-6">
      <header class="text-center max-w-2xl mx-auto mb-10">
        <div class="inline-flex items-center gap-2 px-3.5 py-1 rounded-full bg-emerald-500/10 border border-emerald-500/30 text-emerald-600 dark:text-emerald-400 text-xs font-mono font-bold mb-3">
          <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span>
          Application Verified & Profile Locked
        </div>
        <h1 class="text-3xl sm:text-4xl font-black text-slate-900 dark:text-white tracking-tight">
          Secure Payment <span class="text-transparent bg-clip-text bg-gradient-to-r from-sky-600 via-cyan-500 to-sky-400">Terminal</span>
        </h1>
        <p class="text-xs sm:text-sm text-slate-600 dark:text-slate-300 mt-2 font-normal">
          Review your enrolled program invoice and proceed to PayU 256-bit encrypted checkout.
        </p>
      </header>

      <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">
        
        <!-- Left: Verified Candidate Form -->
        <main class="lg:col-span-6">
          <div class="p-7 sm:p-8 rounded-3xl border border-sky-100 dark:border-sky-950/80 bg-white/80 dark:bg-[#070e1c]/90 backdrop-blur-xl shadow-xl space-y-6">
            
            <div class="flex items-center justify-between pb-3 border-b border-sky-100 dark:border-sky-950">
              <h2 class="text-xs font-mono font-bold uppercase tracking-wider text-slate-900 dark:text-white flex items-center gap-2">
                <span class="w-2 h-2 rounded-full bg-sky-500"></span>
                Candidate Credentials
              </h2>
              <span class="text-[11px] font-mono text-emerald-600 dark:text-emerald-400">✓ Step 2 of 2</span>
            </div>

            <form id="checkout-gateway-form" class="space-y-4 text-xs font-mono">
              <input type="hidden" id="course-id" value={course?.id} />
              <input type="hidden" id="payment-plan" value={initialPlan} />

              <div>
                <label class="block text-slate-500 mb-1.5 font-bold">Candidate Full Name</label>
                <input 
                  type="text" 
                  id="firstname" 
                  readonly 
                  value={studentName} 
                  required 
                  class="w-full px-4 py-3 rounded-xl border border-sky-100 dark:border-sky-900/60 bg-sky-50/30 dark:bg-slate-900/50 text-slate-900 dark:text-white font-bold outline-none cursor-not-allowed"
                />
              </div>

              <div>
                <label class="block text-slate-500 mb-1.5 font-bold">Registered Email Address</label>
                <input 
                  type="email" 
                  id="email" 
                  readonly 
                  value={studentEmail} 
                  required 
                  class="w-full px-4 py-3 rounded-xl border border-sky-100 dark:border-sky-900/60 bg-sky-50/30 dark:bg-slate-900/50 text-slate-900 dark:text-white font-bold outline-none cursor-not-allowed"
                />
              </div>

              <div>
                <label class="block text-slate-500 mb-1.5 font-bold">WhatsApp Mobile Number</label>
                <input 
                  type="tel" 
                  id="phone" 
                  readonly 
                  value={studentPhone} 
                  required 
                  class="w-full px-4 py-3 rounded-xl border border-sky-100 dark:border-sky-900/60 bg-sky-50/30 dark:bg-slate-900/50 text-slate-900 dark:text-white font-bold outline-none cursor-not-allowed"
                />
              </div>

              <div id="checkout-error" class="hidden p-3.5 rounded-xl bg-rose-500/10 border border-rose-500/30 text-rose-500 text-xs font-sans"></div>

              <div class="pt-2">
                <button 
                  type="submit" 
                  id="pay-btn"
                  class="w-full py-4 rounded-xl font-mono font-bold text-sm text-white bg-sky-600 hover:bg-sky-500 transition-all shadow-lg shadow-sky-600/25 cursor-pointer flex items-center justify-center gap-2"
                >
                  <span id="btn-text">Proceed to PayU Gateway ({currency}{payableAmount.toLocaleString('en-IN')}) &rarr;</span>
                  <span id="btn-spinner" class="hidden animate-spin text-base">⟳</span>
                </button>
              </div>

              <p class="text-[11px] font-sans text-slate-400 text-center leading-relaxed">
                Need to edit your information? <a href={`/courses/enquiry?course=${course?.id}&plan=${initialPlan}`} class="text-sky-500 hover:underline">Go back to application</a>
              </p>
            </form>

          </div>
        </main>

        <!-- Right: Expanded & Polished Payable Invoice -->
        <aside class="lg:col-span-6 sticky top-28 space-y-6">
          <div class="p-7 sm:p-8 rounded-3xl border border-sky-200 dark:border-sky-900 bg-white dark:bg-[#070e1c] shadow-xl space-y-5 font-mono text-xs">
            
            <div class="flex items-center justify-between pb-3 border-b border-sky-100 dark:border-sky-950">
              <span class="text-xs font-mono font-bold uppercase tracking-wider text-slate-400">
                Official Tuition Invoice
              </span>
              <span class="px-2.5 py-0.5 rounded-full text-[10px] font-bold bg-sky-50 dark:bg-sky-950/60 text-sky-600 dark:text-sky-400 border border-sky-200 dark:border-sky-800">
                INVOICE PREVIEW
              </span>
            </div>

            <!-- Full Un-truncated Program Title & Badges -->
            <div class="space-y-3 pt-1">
              <span class="text-[10px] font-bold uppercase tracking-wider text-slate-400 block">Enrolled Program</span>
              <h3 class="text-base sm:text-lg font-bold text-slate-900 dark:text-white leading-snug font-sans">
                {course?.data.title}
              </h3>

              <div class="flex flex-wrap items-center gap-1.5 pt-1">
                <span class="px-2.5 py-1 rounded-lg bg-sky-50/70 dark:bg-sky-950/60 text-sky-700 dark:text-sky-300 border border-sky-200/60 dark:border-sky-900/60 font-medium text-[11px]">
                  ⏱️ {course?.data.duration}
                </span>
                <span class="px-2.5 py-1 rounded-lg bg-slate-100 dark:bg-slate-900 text-slate-600 dark:text-slate-400 border border-slate-200 dark:border-slate-800 text-[11px]">
                  📑 {course?.data.totalLessons} Sessions
                </span>
                <span class="px-2.5 py-1 rounded-lg bg-slate-100 dark:bg-slate-900 text-slate-600 dark:text-slate-400 border border-slate-200 dark:border-slate-800 text-[11px]">
                  {course?.data.level}
                </span>
              </div>
            </div>

            <!-- Itemized Financial Breakdown -->
            <div class="pt-4 border-t border-sky-100 dark:border-sky-950 space-y-3">
              <div class="flex justify-between items-center text-slate-600 dark:text-slate-400">
                <span>Tuition Schedule</span>
                <span class="text-slate-900 dark:text-white font-bold text-right">{planLabel}</span>
              </div>

              <div class="flex justify-between items-center text-slate-600 dark:text-slate-400">
                <span>Standard Program Fee</span>
                <span class="line-through text-slate-400 font-medium">{currency}{originalPrice.toLocaleString('en-IN')}</span>
              </div>

              {course?.data.discountBadge && initialPlan === 'full' && (
                <div class="flex justify-between items-center text-rose-500 font-bold">
                  <span>Founding Cohort Discount</span>
                  <span>{course.data.discountBadge} (-{currency}{(originalPrice - price).toLocaleString('en-IN')})</span>
                </div>
              )}

              <div class="flex justify-between items-center text-slate-600 dark:text-slate-400">
                <span>1-on-1 Code Review & Mentorship</span>
                <span class="text-emerald-500 font-bold">Included</span>
              </div>

              <div class="flex justify-between items-center text-slate-600 dark:text-slate-400">
                <span>Taxes & Gateway Convenience</span>
                <span class="text-slate-900 dark:text-white font-bold">₹0.00</span>
              </div>

              <div class="pt-4 border-t border-sky-100 dark:border-sky-950 flex justify-between items-baseline text-sm font-bold text-slate-900 dark:text-white">
                <span class="text-xs uppercase tracking-wider text-slate-400">Total Payable Now</span>
                <span class="text-xl sm:text-2xl text-sky-600 dark:text-sky-400 font-mono font-black">
                  {currency}{payableAmount.toLocaleString('en-IN')} <span class="text-xs font-normal text-slate-400">INR</span>
                </span>
              </div>
            </div>

            <!-- Assurance & Deliverables Checklist -->
            <div class="pt-4 border-t border-sky-100 dark:border-sky-950 text-[11px] text-slate-500 dark:text-slate-400 space-y-2">
              <p class="flex items-center gap-2">
                <span class="text-emerald-500 font-bold">✓</span>
                <span>Immediate GitHub repository & architectural notes invite</span>
              </p>
              <p class="flex items-center gap-2">
                <span class="text-emerald-500 font-bold">✓</span>
                <span>Tax compliant GST / Corporate invoice dispatched via email</span>
              </p>
              <p class="flex items-center gap-2">
                <span class="text-emerald-500 font-bold">✓</span>
                <span>Direct 1-on-1 calendar onboarding with Shibaji Debnath</span>
              </p>
            </div>

          </div>
        </aside>

      </div>
    </div>
  </div>
</Layout>

<script is:inline>
  const form = document.getElementById('checkout-gateway-form');
  const payBtn = document.getElementById('pay-btn');
  const spinner = document.getElementById('btn-spinner');
  const btnText = document.getElementById('btn-text');
  const errorBox = document.getElementById('checkout-error');

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    errorBox.classList.add('hidden');
    payBtn.disabled = true;
    spinner.classList.remove('hidden');
    btnText.textContent = "Connecting to PayU Terminal...";

    const payload = {
      firstname: document.getElementById('firstname').value.trim(),
      email: document.getElementById('email').value.trim(),
      phone: document.getElementById('phone').value.trim(),
      course_id: document.getElementById('course-id').value,
      payment_plan: document.getElementById('payment-plan').value,
    };

    try {
      const res = await fetch('/api/payu/init.php', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(payload)
      });

      const result = await res.json();

      if (result.status === 'success') {
        if (result.is_free && result.redirect_url) {
          window.location.href = result.redirect_url;
          return;
        }

        if (result.action && result.params) {
          const payuForm = document.createElement('form');
          payuForm.method = 'POST';
          payuForm.action = result.action;

          for (const [key, val] of Object.entries(result.params)) {
            const input = document.createElement('input');
            input.type = 'hidden';
            input.name = key;
            input.value = val;
            payuForm.appendChild(input);
          }

          document.body.appendChild(payuForm);
          payuForm.submit();
        }
      } else {
        throw new Error(result.message || 'Payment terminal initialization failed.');
      }
    } catch (err) {
      errorBox.textContent = err.message || 'Connection error. Please try again.';
      errorBox.classList.remove('hidden');
      payBtn.disabled = false;
      spinner.classList.add('hidden');
      btnText.textContent = "Try Again";
    }
  });
</script>