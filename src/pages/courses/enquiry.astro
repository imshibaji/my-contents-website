---
import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'astro:content';

const courses = await getCollection('courses');

const courseCatalog = courses.map((c) => ({
  slug: c.id.replace(/\.md$/, ''),
  title: c.data.title,
  duration: c.data.duration,
  totalLessons: c.data.totalLessons,
  level: c.data.level,
  price: Number(c.data.price),
  originalPrice: Number(c.data.originalPrice ?? c.data.price),
  discountBadge: c.data.discountBadge ?? '',
  installmentPrice: Number(c.data.installmentPrice ?? 0),
  installmentPlanText: c.data.installmentPlanText ?? '',
}));
---

<Layout title="Cohort Candidate Application — Shibaji Debnath">
  <div class="min-h-screen bg-slate-50 dark:bg-[#06080f] text-slate-800 dark:text-slate-200 py-12 px-4 sm:px-6 lg:px-8 transition-colors duration-300">
    <div class="max-w-6xl mx-auto">
      
      <!-- Top Breadcrumb / Back Link -->
      <div class="mb-8">
        <a 
          id="back_to_course"
          href="/courses" 
          class="text-xs font-mono uppercase tracking-widest text-sky-600 dark:text-sky-400 hover:text-sky-500 dark:hover:text-sky-300 flex items-center gap-1 transition-colors"
        >
          &larr; Back to Program Details / Candidate Application
        </a>
        <h1 class="text-3xl sm:text-4xl font-black text-slate-900 dark:text-white tracking-tight mt-3">
          Cohort Candidate <span class="text-transparent bg-clip-text bg-gradient-to-r from-sky-600 to-indigo-600 dark:from-sky-400 dark:to-indigo-400">Application</span>
        </h1>
        <p class="text-sm text-slate-600 dark:text-slate-400 mt-2 max-w-2xl">
          Submit your candidate profile to initiate technical registration. Both you and the mentor will receive a verified confirmation dispatch prior to gateway checkout.
        </p>
      </div>

      <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">
        
        <!-- Left: Intake Form -->
        <div class="lg:col-span-7 bg-white dark:bg-[#0b101d]/90 border border-slate-200 dark:border-slate-800/80 rounded-2xl p-6 sm:p-8 backdrop-blur shadow-xl dark:shadow-2xl relative transition-colors duration-300">
          <div class="flex items-center justify-between pb-6 border-b border-slate-200 dark:border-slate-800/60 mb-6">
            <span class="text-xs font-mono tracking-widest uppercase text-sky-600 dark:text-sky-400 flex items-center gap-2">
              <span class="h-2 w-2 rounded-full bg-sky-600 dark:bg-sky-400 animate-pulse"></span>
              Candidate Profile
            </span>
            <span class="text-xs font-mono text-slate-400 dark:text-slate-500 uppercase tracking-widest">Step 1 of 2</span>
          </div>

          <form id="enquiry_form" action="/api/enquiry.php" method="POST" class="space-y-6">
            <!-- Hidden Fields -->
            <input type="hidden" name="course_slug" id="form_course_slug" value="" />
            <input type="hidden" name="course_title" id="form_course_title" value="" />
            <input type="hidden" name="payment_plan" id="form_payment_plan" value="full" />
            <input type="hidden" name="payable_amount" id="form_payable_amount" value="0" />

            <!-- Payment Schedule Switcher -->
            <div>
              <label class="block text-xs font-mono uppercase tracking-wider text-slate-700 dark:text-slate-300 mb-3">
                Select Preferred Payment Schedule
              </label>
              
              <div class="grid grid-cols-1 sm:grid-cols-2 gap-3" id="plan_selector_group">
                <!-- Option 1: Full Payment -->
                <label 
                  id="card_plan_full"
                  class="relative flex flex-col p-4 rounded-xl border-2 border-sky-500 bg-sky-50/80 dark:bg-sky-950/20 cursor-pointer transition-all"
                >
                  <input type="radio" name="plan_choice" value="full" class="sr-only" checked />
                  <div class="flex items-center justify-between">
                    <span class="text-sm font-bold text-slate-900 dark:text-white">Full Cohort Access</span>
                    <span id="badge_full_save" class="text-[10px] font-mono font-bold px-2 py-0.5 rounded bg-emerald-100 dark:bg-emerald-500/20 text-emerald-700 dark:text-emerald-400 border border-emerald-300 dark:border-emerald-500/30">
                      BEST VALUE
                    </span>
                  </div>
                  <div class="mt-2 text-xl font-black text-slate-900 dark:text-white" id="text_full_price">₹0</div>
                  <span class="text-[11px] text-slate-500 dark:text-slate-400 mt-1">One-time upfront investment</span>
                </label>

                <!-- Option 2: Milestone / Installment -->
                <label 
                  id="card_plan_installment"
                  class="relative flex flex-col p-4 rounded-xl border border-slate-200 dark:border-slate-800 bg-slate-50/60 dark:bg-[#070b14] cursor-pointer transition-all hover:border-slate-300 dark:hover:border-slate-700"
                >
                  <input type="radio" name="plan_choice" value="installment" class="sr-only" />
                  <div class="flex items-center justify-between">
                    <span class="text-sm font-bold text-slate-900 dark:text-white">Milestone Split</span>
                    <span class="text-[10px] font-mono px-2 py-0.5 rounded bg-slate-200 dark:bg-slate-800 text-slate-700 dark:text-slate-300">SPLIT</span>
                  </div>
                  <div class="mt-2 text-xl font-black text-slate-900 dark:text-white" id="text_installment_price">₹0</div>
                  <span class="text-[11px] text-slate-500 dark:text-slate-400 mt-1" id="text_installment_desc">Milestone based schedule</span>
                </label>
              </div>
            </div>

            <!-- Candidate Details -->
            <div>
              <label for="candidate_name" class="block text-xs font-mono uppercase tracking-wider text-slate-700 dark:text-slate-300 mb-2">
                Full Name <span class="text-rose-500 dark:text-rose-400">*</span>
              </label>
              <input 
                type="text" 
                id="candidate_name" 
                name="full_name" 
                required 
                placeholder="e.g. Subhankar Sen"
                class="w-full bg-slate-50 dark:bg-[#070b14] border border-slate-200 dark:border-slate-800 rounded-xl px-4 py-3 text-sm text-slate-900 dark:text-white placeholder-slate-400 dark:placeholder-slate-600 focus:outline-none focus:border-sky-500 transition-colors"
              />
            </div>

            <div>
              <label for="candidate_email" class="block text-xs font-mono uppercase tracking-wider text-slate-700 dark:text-slate-300 mb-2">
                Email Address <span class="text-rose-500 dark:text-rose-400">*</span>
              </label>
              <input 
                type="email" 
                id="candidate_email" 
                name="email" 
                required 
                placeholder="subhankar@example.com"
                class="w-full bg-slate-50 dark:bg-[#070b14] border border-slate-200 dark:border-slate-800 rounded-xl px-4 py-3 text-sm text-slate-900 dark:text-white placeholder-slate-400 dark:placeholder-slate-600 focus:outline-none focus:border-sky-500 transition-colors"
              />
            </div>

            <div>
              <label for="candidate_phone" class="block text-xs font-mono uppercase tracking-wider text-slate-700 dark:text-slate-300 mb-2">
                WhatsApp Phone Number <span class="text-rose-500 dark:text-rose-400">*</span>
              </label>
              <input 
                type="tel" 
                id="candidate_phone" 
                name="phone" 
                required 
                placeholder="+91 98765 43210"
                class="w-full bg-slate-50 dark:bg-[#070b14] border border-slate-200 dark:border-slate-800 rounded-xl px-4 py-3 text-sm text-slate-900 dark:text-white placeholder-slate-400 dark:placeholder-slate-600 focus:outline-none focus:border-sky-500 transition-colors"
              />
            </div>

            <button 
              type="submit" 
              id="submit_btn"
              class="w-full py-3.5 px-6 rounded-xl bg-gradient-to-r from-sky-600 to-indigo-600 hover:from-sky-500 hover:to-indigo-500 text-white font-bold text-sm tracking-wide shadow-lg shadow-sky-500/20 hover:shadow-sky-500/40 transition-all flex items-center justify-center gap-2 cursor-pointer"
            >
              <span>Submit Application &amp; Proceed to Terminal</span>
              <span>&rarr;</span>
            </button>

            <p class="text-center text-[11px] text-slate-500 dark:text-slate-400">
              🔒 Application submission generates verified email telemetry for both you and the mentor prior to payment.
            </p>
          </form>
        </div>

        <!-- Right: Dynamic Application Summary -->
        <div class="lg:col-span-5 bg-white dark:bg-[#0b101d]/90 border border-slate-200 dark:border-slate-800/80 rounded-2xl p-6 sm:p-8 backdrop-blur shadow-xl dark:shadow-2xl space-y-6 sticky top-8 transition-colors duration-300">
          <div class="pb-4 border-b border-slate-200 dark:border-slate-800/60">
            <span class="text-[11px] font-mono tracking-widest uppercase text-slate-500 dark:text-slate-400">Application Summary</span>
            <h2 id="summary_course_title" class="text-lg sm:text-xl font-black text-slate-900 dark:text-white mt-1 leading-snug">
              Loading Course...
            </h2>
            <div class="flex flex-wrap items-center gap-2 mt-3">
              <span id="summary_badge_duration" class="px-2.5 py-1 rounded-md text-[11px] font-mono bg-sky-100 dark:bg-sky-950/60 text-sky-800 dark:text-sky-400 border border-sky-200 dark:border-sky-800/40">
                -- Duration
              </span>
              <span id="summary_badge_lessons" class="px-2.5 py-1 rounded-md text-[11px] font-mono bg-indigo-100 dark:bg-indigo-950/60 text-indigo-800 dark:text-indigo-400 border border-indigo-200 dark:border-indigo-800/40">
                -- Lessons
              </span>
              <span id="summary_badge_level" class="px-2.5 py-1 rounded-md text-[11px] font-mono bg-slate-100 dark:bg-slate-800 text-slate-700 dark:text-slate-300 border border-slate-200 dark:border-slate-700/50">
                -- Level
              </span>
            </div>
          </div>

          <!-- Cost Breakdown List -->
          <div class="space-y-3 text-xs text-slate-600 dark:text-slate-300">
            <div class="flex justify-between items-center py-1">
              <span class="text-slate-500 dark:text-slate-400">Selected Schedule</span>
              <span id="summary_schedule_label" class="font-mono font-medium text-slate-900 dark:text-white">Full Cohort Access</span>
            </div>
            <div class="flex justify-between items-center py-1">
              <span class="text-slate-500 dark:text-slate-400">Program Original Fee</span>
              <span id="summary_original_fee" class="font-mono line-through text-slate-400 dark:text-slate-500">₹0</span>
            </div>
            <div class="flex justify-between items-center py-1">
              <span class="text-slate-500 dark:text-slate-400">Promotional Discount</span>
              <span id="summary_discount_tag" class="font-mono text-emerald-600 dark:text-emerald-400 font-semibold">0% OFF</span>
            </div>
            <div class="flex justify-between items-center py-1">
              <span class="text-slate-500 dark:text-slate-400">1-on-1 Code Review &amp; Labs</span>
              <span class="font-mono text-emerald-600 dark:text-emerald-400 font-semibold">Included</span>
            </div>
            <div class="flex justify-between items-center py-1">
              <span class="text-slate-500 dark:text-slate-400">Application Fees</span>
              <span class="font-mono text-emerald-600 dark:text-emerald-400 font-semibold">₹0.00</span>
            </div>
          </div>

          <!-- Total Due -->
          <div class="pt-5 border-t border-slate-200 dark:border-slate-800/80 flex items-baseline justify-between">
            <div>
              <span class="block text-xs font-mono uppercase tracking-wider text-slate-500 dark:text-slate-400">Total Payable Upon Approval</span>
              <span class="text-[10px] text-slate-400 dark:text-slate-500">All gateway charges inclusive</span>
            </div>
            <div class="text-right">
              <span id="summary_total_payable" class="text-2xl sm:text-3xl font-black text-sky-600 dark:text-sky-400 font-mono">₹0</span>
              <span class="block text-[10px] font-mono text-slate-400 dark:text-slate-500">INR</span>
            </div>
          </div>

          <!-- Feature Bullets -->
          <div class="pt-4 border-t border-slate-200 dark:border-slate-800/40 space-y-2 text-[11px] text-slate-600 dark:text-slate-400">
            <div class="flex items-center gap-2">
              <span class="text-sky-600 dark:text-sky-400 font-bold">✓</span> Direct Mentor Access &amp; Architecture Group Sync
            </div>
            <div class="flex items-center gap-2">
              <span class="text-sky-600 dark:text-sky-400 font-bold">✓</span> Instant Invoicing &amp; Confirmation Copy Delivered
            </div>
          </div>
        </div>

      </div>
    </div>
  </div>

  <!-- Client-Side Synchronization Script -->
  <script define:vars={{ courseCatalog }}>
    function initEnquiryPage() {
      const params = new URLSearchParams(window.location.search);
      const urlCourseSlug = params.get('course');
      let currentPlan = (params.get('plan') || 'full').toLowerCase();

      // ১. কোর্স ফাইন্ডার
      const activeCourse = courseCatalog.find((c) => c.slug === urlCourseSlug) || courseCatalog[0];
      if (!activeCourse) return;

      // ২. ইনস্টলমেন্ট প্রাপ্যতা যাচাই
      const hasInstallment = activeCourse.installmentPrice && activeCourse.installmentPrice > 0;
      if (!hasInstallment && currentPlan === 'installment') {
        currentPlan = 'full';
      }

      // ৩. ব্যাক লিঙ্ক আপডেট
      const backLink = document.getElementById('back_to_course');
      if (backLink) backLink.href = `/courses/${activeCourse.slug}`;

      // ৪. হিডেন ফর্ম ফিল্ডস সেট করা
      const slugInput = document.getElementById('form_course_slug');
      const titleInput = document.getElementById('form_course_title');
      const planInput = document.getElementById('form_payment_plan');
      const amountInput = document.getElementById('form_payable_amount');

      if (slugInput) slugInput.value = activeCourse.slug;
      if (titleInput) titleInput.value = activeCourse.title;
      if (planInput) planInput.value = currentPlan;

      // ৫. সামারি মেটা আপডেট
      const titleEl = document.getElementById('summary_course_title');
      const durationEl = document.getElementById('summary_badge_duration');
      const lessonsEl = document.getElementById('summary_badge_lessons');
      const levelEl = document.getElementById('summary_badge_level');
      const fullPriceEl = document.getElementById('text_full_price');
      const originalFeeEl = document.getElementById('summary_original_fee');
      const discountTagEl = document.getElementById('summary_discount_tag');

      if (titleEl) titleEl.textContent = activeCourse.title;
      if (durationEl) durationEl.textContent = activeCourse.duration;
      if (lessonsEl) lessonsEl.textContent = `${activeCourse.totalLessons} Lessons`;
      if (levelEl) levelEl.textContent = activeCourse.level;
      if (fullPriceEl) fullPriceEl.textContent = `₹${activeCourse.price.toLocaleString('en-IN')}`;
      if (originalFeeEl) originalFeeEl.textContent = `₹${activeCourse.originalPrice.toLocaleString('en-IN')}`;
      if (discountTagEl) discountTagEl.textContent = activeCourse.discountBadge || 'STANDARD';

      // ৬. ইনস্টলমেন্ট কার্ড কন্ট্রোল
      const instCard = document.getElementById('card_plan_installment');
      const instPriceText = document.getElementById('text_installment_price');
      const instDescText = document.getElementById('text_installment_desc');

      if (instCard && instPriceText && instDescText) {
        if (hasInstallment) {
          instCard.classList.remove('hidden');
          instPriceText.textContent = `₹${activeCourse.installmentPrice.toLocaleString('en-IN')}`;
          instDescText.textContent = activeCourse.installmentPlanText || 'Split milestone payment';
        } else {
          instCard.classList.add('hidden');
        }
      }

      // ৭. UI স্টাইলিং ও টোটাল ক্যালকুলেট করার ফাংশন
      const updatePlanUI = (selectedPlan) => {
        currentPlan = selectedPlan;
        if (planInput) planInput.value = currentPlan;

        const fullCard = document.getElementById('card_plan_full');
        const totalEl = document.getElementById('summary_total_payable');
        const scheduleLabel = document.getElementById('summary_schedule_label');

        const activeClasses = "relative flex flex-col p-4 rounded-xl border-2 border-sky-500 bg-sky-50/80 dark:bg-sky-950/20 cursor-pointer transition-all";
        const inactiveClasses = "relative flex flex-col p-4 rounded-xl border border-slate-200 dark:border-slate-800 bg-slate-50/60 dark:bg-[#070b14] cursor-pointer transition-all hover:border-slate-300 dark:hover:border-slate-700";

        if (currentPlan === 'full') {
          if (fullCard) fullCard.className = activeClasses;
          if (instCard) instCard.className = inactiveClasses;
          if (scheduleLabel) scheduleLabel.textContent = "Full Cohort Access";
          if (totalEl) totalEl.textContent = `₹${activeCourse.price.toLocaleString('en-IN')}`;
          if (amountInput) amountInput.value = activeCourse.price;
        } else {
          if (instCard) instCard.className = activeClasses;
          if (fullCard) fullCard.className = inactiveClasses;
          if (scheduleLabel) scheduleLabel.textContent = "Milestone Split";
          if (totalEl) totalEl.textContent = `₹${activeCourse.installmentPrice.toLocaleString('en-IN')}`;
          if (amountInput) amountInput.value = activeCourse.installmentPrice;
        }
      };

      updatePlanUI(currentPlan);

      const fullCard = document.getElementById('card_plan_full');
      if (fullCard) {
        fullCard.onclick = () => updatePlanUI('full');
      }
      if (hasInstallment && instCard) {
        instCard.onclick = () => updatePlanUI('installment');
      }
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initEnquiryPage);
    } else {
      initEnquiryPage();
    }
    document.addEventListener('astro:page-load', initEnquiryPage);
  </script>
</Layout>