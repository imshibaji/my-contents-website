<?php
// api/credential.php
//
// Copy this file to credential.php on the server and fill in the real values.
// credential.php is gitignored; this template is the committed version.
//
//   cp credential.php.example credential.php
//
// Returned as an array. Empty string means "not set", so a blank entry falls
// through to the host environment variable of the same name, which is set in
// hPanel -> PHP -> Configuration. A host value always wins over this file, so
// fixing a value in the panel cannot be undone by forgetting to update here.
//
// Do not commit credential.php. It holds live secrets.
//
// Keys used by this app:
//   PAYU_MERCHANT_KEY, PAYU_MERCHANT_SALT   payu/config.php
//   PAYU_MODE, SITE_URL, ADMIN_EMAIL        payu/config.php
//   SMTP_GMAIL_USER, SMTP_GMAIL_PASS        send-mail.php
//   PUBLIC_SUPABASE_URL, SUPABASE_SERVICE_KEY  tool-lead.php, tool-sequence-supabase.php
//   DB_HOST, DB_PORT, DB_NAME, DB_USER, DB_PASSWORD  enquiry.php

return [
    // ── PayU ────────────────────────────────────────────────────────────────
    'PAYU_MERCHANT_KEY'  => '',
    'PAYU_MERCHANT_SALT' => '',
    // PROD for real payments. TEST silently sends buyers to test.payu.in,
    // where nothing is charged and no enrollment is created.
    'PAYU_MODE'          => 'PROD',
    'SITE_URL'           => 'https://shibajidebnath.com',
    'ADMIN_EMAIL'        => '',

    // ── PayU currency switch ───────────────────────────────────────────────
    // This account returns two contradictory errors, so no single payload
    // satisfies both. Read the comment block in api/payu/config.php first.
    //   none        → send no currency field (default)
    //   transaction → send transactionCurrency (multi-currency accounts)
    'PAYU_CURRENCY_MODE' => 'none',
    'PAYU_TRANSACTION_CURRENCY' => 'INR',
    // The merchant account currency. When it differs from the transaction
    // currency, PayU also requires amountToBeConverted and usdAsssedValueCurrency.
    'PAYU_ACCOUNT_CURRENCY' => 'INR',

    // ── Which PayU API to use ──────────────────────────────────────────────
    // 'legacy' → form redirect on /_payment with a SHA-512 salt hash.
    // 'v2'     → JSON API at /v2/payments with an HMAC signature. Required for
    //            test key 59xiPf: the legacy endpoint rejects every payload,
    //            see the comment block in api/payu/config.php.
    'PAYU_API_VERSION' => 'legacy',

    // v2 requires billingDetails.address1, which the enquiry form does not
    // collect. Defaults to a generic city address; override if you need a real one.
    // 'PAYU_BILLING_ADDRESS1' => '...',
    // 'PAYU_BILLING_CITY'     => '...',
    // 'PAYU_BILLING_STATE'    => '...',
    // 'PAYU_BILLING_ZIP'      => '...',

    // Full override of the gateway URL. Useful for checking whether a merchant
    // key behaves identically on secure.payu.in and test.payu.in.
    // 'PAYU_GATEWAY_URL' => 'https://secure.payu.in/_payment',

    // ── SMTP (Gmail app password, not the account password) ─────────────────
    'SMTP_GMAIL_USER'    => '',
    'SMTP_GMAIL_PASS'    => '',

    // ── Supabase ────────────────────────────────────────────────────────────
    // service_role bypasses row-level security. Keep it server-side only.
    'PUBLIC_SUPABASE_URL' => '',
    'SUPABASE_SERVICE_KEY' => '',

    // ── Postgres (enquiry.php) ──────────────────────────────────────────────
    // These must be real: with no host variable, an unset value silently
    // dialled 127.0.0.1 and every enquiry was lost without an error.
    'DB_HOST'     => '',
    'DB_PORT'     => '5432',
    'DB_NAME'     => '',
    'DB_USER'     => '',
    'DB_PASSWORD' => '',
];