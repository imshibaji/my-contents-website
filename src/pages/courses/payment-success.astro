---
import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'astro:content';

// Google Ads Purchase Conversion Credentials
const GOOGLE_ADS_ID = 'AW-16766094351';
const ADS_PURCHASE_CONVERSION_LABEL = 'Purchased';

// স্লাগ -> ডিসপ্লে টাইটেল ম্যাপ (slug পাঠানো হয়, ইউজার টাইটেল দেখুন)
const courses = await getCollection('courses');
const COURSE_TITLES: Record<string, string> = {};
for (const c of courses) {
  COURSE_TITLES[c.id.replace(/\.md$/, '')] = c.data.title;
}

// এই পেজটি static build, তাই build সময়ে query string পাওয়া যায় না।
// runtime-এ URL param পড়া হয় (script-এ), নিচের server-side মানগুলো শুধু fallback।
const urlData = new URL(Astro.url);
const serverTxnid = urlData.searchParams.get('txnid') || urlData.searchParams.get('txn_id');
const serverAmount = urlData.searchParams.get('amount') || urlData.searchParams.get('price');
const serverCourse = urlData.searchParams.get('course');
const isFreeEnrollment = urlData.searchParams.get('free') === '1';
---

<Layout title="Enrollment Confirmed | Shibaji Debnath" description="Payment successfully verified.">
  <div class="min-h-screen py-16 sm:py-20 flex items-center justify-center px-4 sm:px-6 bg-slate-50 dark:bg-[#040813] transition-colors duration-300">
    <div class="max-w-lg w-full p-6 sm:p-10 rounded-3xl border border-emerald-500/30 bg-white dark:bg-[#070e1c] shadow-2xl text-center space-y-6">
      
      <!-- Verified Badge -->
      <div class="w-16 h-16 mx-auto rounded-full bg-emerald-500/10 border border-emerald-500/30 flex items-center justify-center text-emerald-600 dark:text-emerald-400 text-3xl font-bold shadow-lg shadow-emerald-500/10">
        ✓
      </div>

      <div class="space-y-1.5">
        <span class="text-xs font-mono uppercase tracking-wider text-emerald-600 dark:text-emerald-400 font-bold">Payment Verified &amp; Logged</span>
        <h1 class="text-2xl sm:text-3xl font-black text-slate-900 dark:text-white tracking-tight">Cohort Seat Confirmed!</h1>
      </div>

      <p class="text-xs sm:text-sm text-slate-600 dark:text-slate-300 leading-relaxed font-normal">
        Thank you for enrolling. Your admission invoice and architecture sandbox credentials have been automatically dispatched to your email.
      </p>

      <!-- Dynamic Transaction Details Card -->
      <div class="p-4 sm:p-5 rounded-2xl bg-slate-50 dark:bg-[#0b1222] border border-slate-200 dark:border-slate-800/80 text-xs font-mono text-left space-y-2 text-slate-700 dark:text-slate-300">
        <div class="flex justify-between items-start gap-3 py-1 border-b border-slate-200 dark:border-slate-800/60">
          <span class="text-slate-500 dark:text-slate-400 shrink-0">Enrolled Program:</span>
          <span id="display-course-name" class="font-bold text-slate-900 dark:text-white text-right break-words">Awaiting confirmation…</span>
        </div>
        <div class="flex justify-between items-center gap-3 py-1 border-b border-slate-200 dark:border-slate-800/60">
          <span class="text-slate-500 dark:text-slate-400 shrink-0">Transaction ID:</span>
          <span id="display-txn-id" class="font-bold text-slate-800 dark:text-slate-200 break-all text-right">--</span>
        </div>
        <div class="flex justify-between items-center gap-3 py-1 border-b border-slate-200 dark:border-slate-800/60">
          <span class="text-slate-500 dark:text-slate-400 shrink-0">Amount Paid:</span>
          <span id="display-amount" class="font-bold text-emerald-600 dark:text-emerald-400 shrink-0">₹0.00</span>
        </div>
        <div class="flex justify-between items-center gap-3 py-1 border-b border-slate-200 dark:border-slate-800/60">
          <span class="text-slate-500 dark:text-slate-400 shrink-0">Payment Mode:</span>
          <span class="text-slate-800 dark:text-slate-200 font-medium text-right">Online Gateway</span>
        </div>
        <div class="flex justify-between items-center pt-1">
          <span class="text-slate-500 dark:text-slate-400 shrink-0">Status:</span>
          <span id="display-status" class="text-emerald-600 dark:text-emerald-400 font-bold uppercase text-right">Active / Verified</span>
        </div>
      </div>

      <!-- Action Navigation Links -->
      <div class="pt-2 flex flex-col sm:flex-row gap-3">
        <a href="/courses" class="flex-1 py-3 px-4 rounded-xl border border-sky-200 dark:border-sky-900 bg-white dark:bg-slate-900 text-xs font-mono font-bold text-slate-700 dark:text-slate-200 hover:border-sky-500 transition-all text-center">
          Browse Programs
        </a>
        <a href="/contact" class="flex-1 py-3 px-4 rounded-xl bg-sky-600 hover:bg-sky-500 text-xs font-mono font-bold text-white transition-all shadow-md shadow-sky-600/20 text-center">
          Advisory Direct
        </a>
      </div>

    </div>
  </div>

  <!-- Dynamic Parameter Resolution & Purchase Conversion Tracking -->
  <script is:inline define:vars={{ GOOGLE_ADS_ID, ADS_PURCHASE_CONVERSION_LABEL, COURSE_TITLES, serverTxnid, serverAmount, serverCourse, isFreeEnrollment }}>
    // এই ফাংশনটি async, তাই একই পেজে দুইবার কল হলে দুটো fetch একসাথে চলতে পারে।
    // তাই ফ্লাইটে সেট হয়ে যায়।
    let initInFlight = false;

    async function initConfirmedEnrollment() {
      if (initInFlight) return;
      initInFlight = true;

      try {
        const params = new URLSearchParams(window.location.search);

        // define:vars ভ্যারিয়েবলের নাম আর local const-এর নাম সেম হলে TDZ error হয়,
        // তাই এখানে আলাদা নাম ব্যবহার করা হয়েছে।
        const resolvedTxnid = serverTxnid || params.get('txnid') || params.get('txn_id') || '--';
        const rawAmount = serverAmount || params.get('amount') || params.get('price') || '0';
        const parsedAmount = parseFloat(rawAmount) || 0;
        const rawCourse = serverCourse || params.get('course') || '';
        const isFree = isFreeEnrollment || params.get('free') === '1';
        const token = params.get('token') || '';

        const txnEl = document.getElementById('display-txn-id');
        const amtEl = document.getElementById('display-amount');
        const courseEl = document.getElementById('display-course-name');
        const statusEl = document.getElementById('display-status');

        // ─────────────────────────────────────────────────────────────
        // সার্ভার-সাইড যাচাই। URL param ই চিহ্নে বিশ্বাস করা যায় না — যে কেউ
        // নিজে URL বানিয়ে যেকোনো পরিমাণ "কনফার্মড" দেখাতে পারে। response.php
        // HMAC টোকেন যাচাই করে, তাই ভুল URL-এ verified:false আসে।
        // ─────────────────────────────────────────────────────────────
        let verified = false;
        try {
          const qs = new URLSearchParams({
            txnid: resolvedTxnid,
            amount: rawAmount,
            course: rawCourse,
            token: token
          });
          const res = await fetch('/api/payu/response.php?' + qs.toString(), {
            headers: { 'Accept': 'application/json' }
          });
          if (res.ok) {
            const check = await res.json();
            verified = check.verified === true;
          }
        } catch (err) {
          // নেটওয়ার্ক ব্যর্থতায় verified ধরে নেওয়া হয় না — নিরাপদ দিক।
          console.error('[payment-success] verification request failed', err);
        }

        if (!verified) {
          if (statusEl) {
            statusEl.textContent = 'Awaiting Confirmation';
            statusEl.classList.add('text-amber-400');
          }
          if (txnEl) txnEl.textContent = resolvedTxnid;
          if (courseEl && rawCourse) courseEl.textContent = COURSE_TITLES[rawCourse] || rawCourse;
          // পরিমাণ দেখানো হয় না, আর conversion-ও পাঠানো হয় না।
          if (amtEl) amtEl.textContent = '—';
          return;
        }

        // স্লাগ পাঠালে ডিসপ্লে টাইটেল দেখাও, না পারলে slug-ই দেখাও
        const courseLabel = (rawCourse && (COURSE_TITLES[rawCourse] || rawCourse)) || 'Program Enrollment';

        // UI আপডেট
        if (txnEl) txnEl.textContent = resolvedTxnid;
        if (amtEl) amtEl.textContent = isFree ? '₹0 (Free)' : `₹${parsedAmount.toLocaleString('en-IN', { minimumFractionDigits: 2, maximumFractionDigits: 2 })}`;
        if (courseEl) courseEl.textContent = courseLabel;
        if (statusEl && isFree) statusEl.textContent = 'Free Enrollment / Active';

        // ডুপ্লিকেট কনভার্সন রিলোড রোধে sessionStorage চেক
        const conversionStorageKey = `converted_${resolvedTxnid}`;
        if (sessionStorage.getItem(conversionStorageKey)) {
          return;
        }

        // ==========================================
        // Purchase Conversion Dispatch (GA4 & Google Ads)
        // যাচাই সফল হওয়ার পরেই — নইলে যে কেউ চাইলেই ভুল URL দিয়ে
        // বিজ্ঞাপনের হিসাব নষ্ট করতে পারত।
        // ==========================================
        if (typeof window.gtag === 'function') {
        window.gtag('event', 'purchase', {
          transaction_id: resolvedTxnid,
          value: parsedAmount,
          currency: 'INR',
          items: [{
            item_name: courseLabel,
            item_category: 'Course Enrollment',
            price: parsedAmount,
            quantity: 1
          }]
        });

        if (GOOGLE_ADS_ID && ADS_PURCHASE_CONVERSION_LABEL && ADS_PURCHASE_CONVERSION_LABEL !== 'YOUR_PURCHASE_CONVERSION_LABEL') {
          window.gtag('event', 'conversion', {
            send_to: `${GOOGLE_ADS_ID}/${ADS_PURCHASE_CONVERSION_LABEL}`,
            value: parsedAmount,
            currency: 'INR',
            transaction_id: resolvedTxnid
          });
        }

        sessionStorage.setItem(conversionStorageKey, 'true');
        }
      } catch (err) {
        console.error('[payment-success] init failed', err);
      } finally {
        initInFlight = false;
      }
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initConfirmedEnrollment);
    } else {
      initConfirmedEnrollment();
    }
    document.addEventListener('astro:page-load', initConfirmedEnrollment);
  </script>
</Layout>